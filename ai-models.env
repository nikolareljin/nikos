# The fleet's approved set: one model per role, with a model per class of
# machine. NikOS installs this machine's column of each role, and no other
# model unless one is named on purpose (ADR-0058, amended 2026-10-10).
#
# Models this project uses, by purpose.
#
# Generated from the fleet model registry (schema 2). Do not edit by
# hand: a change here is overwritten by the next sync. To use another model on
# one machine, set the variable in .env; .env wins, except where a line below
# says otherwise.
#
# NAME=model                    the default, for any machine
#
# Other classes of machine get another model. Per name, the best column the
# machine qualifies for is used, and NAME otherwise. Figures are whole GiB as
# the machine reports them.
# NAME_XLARGE=model             its GPUs have NAME_XLARGE_VRAM_GB of memory
# NAME_LARGE=model              its GPUs have NAME_LARGE_VRAM_GB of memory, or
#                               it has AI_TIER_LARGE_RAM_GB of memory
# NAME_SMALL=model              it has less than AI_TIER_SMALL_RAM_GB of memory
#                               and of GPU memory
# A NAME set in .env is used as it is on any machine. AI_MODEL_TIER=small,
# standard, large or xlarge names the class instead of asking the machine. A
# model is pulled only after a disk and memory check; one that does not fit
# falls back one column. A project that has not built this uses NAME everywhere.

# where the classes of machine begin and end, in GiB of memory
AI_TIER_SMALL_RAM_GB=11
AI_TIER_LARGE_RAM_GB=30

# general: chat, RAG answers, summaries, text generation
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_MODEL_SMALL=qwen3.5:2b
OLLAMA_MODEL_LARGE=qwen3.5:9b
OLLAMA_MODEL_LARGE_VRAM_GB=11

# classify: spam, categories, routing, tags
OLLAMA_CLASSIFY_MODEL=qwen3:1.7b

# extract: structured JSON out of text
OLLAMA_EXTRACT_MODEL=qwen3.5:4b
OLLAMA_EXTRACT_MODEL_SMALL=qwen3.5:2b
OLLAMA_EXTRACT_MODEL_LARGE=qwen3.5:9b
OLLAMA_EXTRACT_MODEL_LARGE_VRAM_GB=11

# reasoning: analysis, multi-step agents
OLLAMA_REASONING_MODEL=qwen3:8b
OLLAMA_REASONING_MODEL_SMALL=qwen3.5:4b
OLLAMA_REASONING_MODEL_XLARGE=gpt-oss:20b
OLLAMA_REASONING_MODEL_XLARGE_VRAM_GB=15

# creative: ideas, long-form writing
OLLAMA_CREATIVE_MODEL=gemma4:latest
OLLAMA_CREATIVE_MODEL_SMALL=qwen3.5:4b

# code: code review and coaching
OLLAMA_CODE_MODEL=qwen2.5-coder:7b
OLLAMA_CODE_MODEL_SMALL=qwen3.5:4b
OLLAMA_CODE_MODEL_XLARGE=qwen3-coder:30b
OLLAMA_CODE_MODEL_XLARGE_VRAM_GB=23

# vision: images, video frames, OCR re-read
OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_VISION_MODEL_LARGE=qwen3-vl:8b
OLLAMA_VISION_MODEL_LARGE_VRAM_GB=11

# embed: embeddings
# do not set this one in .env: another embedding model means a new index
OLLAMA_EMBED_MODEL=nomic-embed-text

# tiny: tests and smoke checks
OLLAMA_TINY_MODEL=qwen3:0.6b
