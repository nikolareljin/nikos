#!/usr/bin/env bash
set -euo pipefail

# Absolute path of the CLI this process is running, resolved before anything can
# change the working directory. `nikos update` compares it against the CLI in the
# freshly synced checkout to tell whether it is running code the update replaced.
NIKOS_CLI_PATH="$(cd "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/$(basename -- "${BASH_SOURCE[0]}")"

NIKOS_HOME="${NIKOS_HOME:-${HOME}/.local/share/nikos}"
REPO_URL="${NIKOS_REPO_URL:-https://github.com/nikolareljin/nikos}"
if [[ -r "${NIKOS_HOME}/VERSION" ]]; then
  NIKOS_VERSION="$(cat "${NIKOS_HOME}/VERSION")"
else
  NIKOS_VERSION="unknown"
fi
NIKOS_CONFIG_DIR="${HOME}/.config/nikos"
SELECTIONS_FILE="${NIKOS_CONFIG_DIR}/selected-options.env"
HELPERS="${NIKOS_HOME}/scripts/script-helpers/helpers.sh"
NIKOS_LOG_DIR="${NIKOS_CONFIG_DIR}/logs"
REPO_SYNC_HELPERS="${NIKOS_HOME}/scripts/repo-sync.sh"
PROGRESS_LIB="${NIKOS_HOME}/scripts/nikos-progress.sh"
# Same switch install.sh honours, so one setting covers both.
USE_DIALOG="${NIKOS_USE_DIALOG:-1}"
BECOME_PASSWORD_FILE=""
NIKOS_BECOME_MODE=""
NIKOS_BECOME_ASK_REASON=""
SUDO_KEEPALIVE_PID=""
# Used by sourced repo sync helpers.
# shellcheck disable=SC2034
MAIN_VARS_REL="vars/main.yml"
# shellcheck disable=SC2034
LOCAL_VARS_REL="vars/local.yml"
ANSIBLE_REQUIREMENTS="${NIKOS_HOME}/requirements.yml"

_logfile() {
  local log_file
  log_file="${NIKOS_LOG_DIR}/nikos-$(date +%Y%m%d).log"
  mkdir -p "${NIKOS_LOG_DIR}"
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "${log_file}"
}

# Strip ANSI escape codes from a log file
_strip_ansi_from_log() {
  sed -i 's/\x1b\[[0-9;:]*[a-zA-Z]//g' "$1" 2>/dev/null || true
}

# Parse Ansible PLAY RECAP and print a summary
# Total one PLAY RECAP field across every recap in a log.
#
# An install can run the playbook more than once - the main run, then a second
# for the optional bundles - and each run prints its own PLAY RECAP. Reading
# them with a bare grep returned one line per recap, so `ok` became "177\n10"
# rather than a number: the summary box printed the remainder on its own line,
# and `[[ "0\n1" -gt 0 ]]` failed with a syntax error and evaluated false, which
# silently hid a real failure in the second run. Summing keeps the value an
# integer whatever the number of runs.
_recap_total() {
  local field="$1" file="$2"
  grep -A2 "^PLAY RECAP" "${file}" 2>/dev/null \
    | grep "localhost" \
    | grep -oP "${field}=\\K[0-9]+" \
    | awk '{ total += $1 } END { print total + 0 }'
}

# Leaves dialog's screen: clears it and restores the normal screen, so the
# summary prints on a clean terminal instead of under a dead gauge.
_leave_tui() {
  if [[ -e /dev/tty ]] && { : >/dev/tty; } 2>/dev/null; then
    { command -v dialog >/dev/null 2>&1 && dialog --clear; } >/dev/tty 2>/dev/null || true
    { tput rmcup 2>/dev/null; tput cnorm 2>/dev/null || printf '\033[?25h'; clear 2>/dev/null; } >/dev/tty 2>/dev/null || true
  fi
}

# Leaves a question box. Unlike _leave_tui it does not clear: the terminal keeps
# what the command printed before the box, such as the repository sync. The boxes
# need --keep-tite for that: without it dialog drops the alternate screen and
# draws over the normal one. A terminal with no alternate screen (TERM=linux)
# keeps the box until later output scrolls it away.
# No rmcup here: dialog has already restored the screen, and on rxvt, konsole and
# gnome a second rmcup erases it.
_leave_box() {
  if [[ -e /dev/tty ]] && { : >/dev/tty; } 2>/dev/null; then
    { tput cnorm 2>/dev/null || printf '\033[?25h'; } >/dev/tty 2>/dev/null || true
  fi
}

# Runs one step of a command (the repository sync, the collection install)
# behind a progressbox, with its output appended to a log, so a run that draws
# the gauge does not print that output between its boxes. $1 is the box text, $2 the log,
# the rest the command, which may be a function. --keep-tite for the same
# reason as the question boxes; no rmcup after it (see _leave_box). The one-line
# captions cmd_update prints between steps stay on the normal screen.
#
# The step runs in the foreground, so Ctrl-C reaches it as on the plain path.
# A box that cannot draw does not stop the step: the `cat` after dialog keeps
# draining the pipe, so neither tee nor the command gets SIGPIPE, and the step
# finishes unseen instead of leaving the checkout half-switched. Stdin is
# /dev/null, so a prompt that reads stdin gets EOF. That does not cover /dev/tty:
# ssh prompts there, and it would draw across the box. See _sync_may_ask_over_ssh.
#
# Returns the command's exit status; EX_IOERR (74) when the command succeeded
# but the log could not be written, as nikos_progress_run reports a lost log.
# The caller reports 74: the step itself worked.
_boxed_step() {
  local text="$1" log="$2"
  shift 2
  local rc=0
  local -a pipe_status=()
  mkdir -p "$(dirname -- "${log}")"
  set +e
  "$@" </dev/null 2>&1 \
    | nikos_progress_strip_ansi \
    | tee -a "${log}" \
    | {
        dialog --keep-tite --title "NikOS ${NIKOS_VERSION}" \
          --progressbox "${text}" "${DIALOG_HEIGHT:-20}" "${DIALOG_WIDTH:-72}" >/dev/tty 2>/dev/tty
        cat >/dev/null
      }
  pipe_status=("${PIPESTATUS[@]}")
  set -e
  _leave_box
  rc="${pipe_status[0]}"
  if (( rc == 0 )) && (( pipe_status[2] != 0 )); then
    rc=74
  fi
  return "${rc}"
}

# After a failed boxed step: the box is gone with everything it showed, so the
# end of its log goes on the terminal, with the path for the rest.
_boxed_step_tail() {
  local log="$1"
  if [[ -s "${log}" ]]; then
    echo "Last lines of ${log}:" >&2
    tail -n 20 -- "${log}" | sed 's/^/  /' >&2
  fi
  echo "Log: ${log}" >&2
}

# Whether git could reach this URL over ssh. Listed by what cannot, so an
# unknown transport counts as ssh and the sync stays where it can be answered.
_url_may_use_ssh() {
  case "$1" in
    "" | http://* | https://* | git://* | file://* | /* | ./* | ../*) return 1 ;;
  esac
  return 0
}

# The ssh command git would run for this checkout.
_sync_ssh_command() {
  local command="${GIT_SSH_COMMAND:-}"
  [[ -n "${command}" ]] || command="$(git -C "${NIKOS_HOME}" config core.sshCommand 2>/dev/null || true)"
  printf '%s\n' "${command:-ssh}"
}

# Whether a boxed sync failed for lack of a prompt: only then does the plain view help.
_sync_log_shows_auth_failure() {
  grep -Eq 'terminal prompts disabled|could not read (Username|Password)|Host key verification failed|Permission denied \(publickey' -- "$1" 2>/dev/null
}

# Whether the sync could reach ssh, which prompts on /dev/tty (passphrase, host
# key) whatever stdin and GIT_TERMINAL_PROMPT say. Such a sync runs plain, not
# boxed: BatchMode would stop the prompt but also fail a passphrase key with no
# agent, which could always update. Checks origin and every submodule URL, after
# url.insteadOf. An unreadable origin, a GIT_SSH wrapper or an ssh command with a
# `#` counts as yes: a comment there would swallow the BatchMode added after it.
_sync_may_ask_over_ssh() {
  local line url
  local -a urls=()
  [[ -z "${GIT_SSH:-}" ]] || return 0
  [[ "$(_sync_ssh_command)" != *"#"* ]] || return 0
  url="$(git -C "${NIKOS_HOME}" remote get-url origin 2>/dev/null)" || return 0
  urls+=("${url}")
  while IFS= read -r line; do
    urls+=("${line#* }")
  done < <(
    git -C "${NIKOS_HOME}" config --file .gitmodules --get-regexp '^submodule\..*\.url$' 2>/dev/null || true
    git -C "${NIKOS_HOME}" config --get-regexp '^submodule\..*\.url$' 2>/dev/null || true
  )
  while IFS= read -r line; do
    urls+=("${line}")
  done < <(git -C "${NIKOS_HOME}" submodule --quiet foreach --recursive 'git remote get-url origin' 2>/dev/null || true)
  for url in "${urls[@]}"; do
    url="$(git -C "${NIKOS_HOME}" ls-remote --get-url "${url}" 2>/dev/null || printf '%s' "${url}")"
    if _url_may_use_ssh "${url}"; then
      return 0
    fi
  done
  return 1
}

# Points playbook-latest.log at a run's log. Called once the run has something to
# record, so a Cancel or an early failure keeps the last real run's log. Creates
# the file first: the link never dangles. A log that cannot be created changes
# nothing.
_publish_run_log() {
  { : >>"$1"; } 2>/dev/null || return 0
  ln -sf "$1" "${NIKOS_LOG_DIR}/playbook-latest.log"
}

# Prints the summary. With use_tui=true and a failed run, also shows it in a
# dialog box on the terminal, so a TUI run ends on the failure, not a blank screen.
_playbook_summary() {
  local log_file="$1" rc="${2:-0}" use_tui="${3:-false}"

  _strip_ansi_from_log "${log_file}"

  local ok changed failed unreachable
  ok=$(_recap_total ok "${log_file}")
  changed=$(_recap_total changed "${log_file}")
  failed=$(_recap_total failed "${log_file}")
  unreachable=$(_recap_total unreachable "${log_file}")

  local text
  text="$(
    echo "Playbook summary"
    echo "  Tasks OK:       ${ok}"
    echo "  Tasks changed:  ${changed}"
    [[ "${failed}"      -gt 0 ]] && echo "  Tasks FAILED:   ${failed}"
    [[ "${unreachable}" -gt 0 ]] && echo "  Unreachable:    ${unreachable}"
    [[ "${rc}" -ne 0 ]] && echo "  Exit code:      ${rc}"

    if [[ "${failed}" -gt 0 || "${unreachable}" -gt 0 ]]; then
      echo ""
      echo "Failed tasks:"
      awk '/^TASK \[/{task=$0} /fatal: \[/{print task}' "${log_file}" 2>/dev/null \
        | sed 's/^TASK \[//;s/\] \*.*$//' \
        | sort -u \
        | while IFS= read -r t; do echo "  - ${t}"; done
    fi

    echo ""
    echo "Log: ${log_file}"
  )"

  echo ""
  echo "----------------------------------------"
  printf '%s\n' "${text}"
  echo "----------------------------------------"

  if [[ "${rc}" -ne 0 && "${use_tui}" == "true" ]] && command -v dialog >/dev/null 2>&1 \
     && [[ -e /dev/tty ]] && { : >/dev/tty; } 2>/dev/null; then
    dialog --title "NikOS: playbook failed" --msgbox "${text}" 22 78 </dev/tty >/dev/tty 2>&1 || true
    _leave_tui
    # The box replaced the screen; print the summary again so it stays in scrollback.
    printf '%s\n' "${text}"
  fi

  _logfile "[SUMMARY] rc=${rc} ok=${ok} changed=${changed} failed=${failed} unreachable=${unreachable}"
}

# Source script-helpers if available (installed via submodule)
if [[ -f "${HELPERS}" ]]; then
  # shellcheck source=/dev/null
  source "${HELPERS}"
  shlib_import logging
  # script-helpers names it print_warning. Without this, the first optional
  # check that failed in `nikos doctor` aborted the whole run with exit 127.
  if ! declare -F print_warn >/dev/null; then
    print_warn() { print_warning "$@"; }
  fi
else
  # Minimal fallback: plain print functions so the rest of the script is uniform
  print_info()    { echo "[info] $*"; }
  print_error()   { echo "[error] $*" >&2; }
  print_success() { echo "[ok] $*"; }
  print_warn()    { echo "[warn] $*"; }
fi

# Render a small terminal header for people, without changing output that
# another command captures. NO_COLOR retains the layout without escape codes.
_print_logo() {
  [[ -t 1 && "${TERM:-dumb}" != "dumb" ]] || return 0

  local gray='' white='' reset='' underlined='' bold_blue='' bold_gray=''
  if [[ -z "${NO_COLOR:-}" ]]; then
    # Match the blue and gray node colors in assets/menu-icon.svg.
    gray=$'\033[38;2;144;164;174m'
    reset="$(printf '%b' "${NC:-$'\033[0m'}")"
    white=$'\033[38;2;255;255;255m'
    underlined=$'\033[4m'
    bold_blue=$'\033[1;38;2;33;150;243m'
    bold_gray=$'\033[1;38;2;144;164;174m'
  fi

  local -a rows plain_rows
  rows=(
    "  ${bold_blue}●${reset}  ${bold_gray}●${reset}                ${bold_blue}NikOS${reset} ${gray}${NIKOS_VERSION}${reset}"
    "  ${bold_blue}┃╲${reset} ${bold_gray}┃${reset}     ${white}Neural Innovation for Knowledge OS${reset}"
    "  ${bold_blue}┃ ╲${reset}${bold_gray}┃${reset}       ${gray}Light system. Heavy thinking.${reset}"
    "  ${bold_gray}●${reset}  ${bold_blue}●${reset}    ${underlined}https://nikolareljin.github.io/nikos${reset}"
  )
  plain_rows=(
    "  ●  ●                NikOS ${NIKOS_VERSION}"
    "  ┃╲ ┃     Neural Innovation for Knowledge OS"
    "  ┃ ╲┃       Light system. Heavy thinking."
    "  ●  ●    https://nikolareljin.github.io/nikos"
  )

  local frame_width=0 index padding horizontal
  for index in "${!plain_rows[@]}"; do
    (( ${#plain_rows[index]} > frame_width )) && frame_width=${#plain_rows[index]}
  done
  printf -v horizontal '%*s' "$((frame_width + 1))" ''
  horizontal="${horizontal// /─}"

  printf '\n'
  printf '  %s┌%s┐%s\n' "${gray}" "${horizontal}" "${reset}"
  for index in "${!rows[@]}"; do
    padding=$((frame_width - ${#plain_rows[index]}))
    printf '  %s│%s%s%*s %s│%s\n' \
      "${gray}" "${reset}" "${rows[index]}" "${padding}" '' "${gray}" "${reset}"
  done
  printf '  %s└%s┘%s\n\n' "${gray}" "${horizontal}" "${reset}"
}

_TOOLS_LIB_LOADED=false
if [[ -f "${NIKOS_HOME}/scripts/nikos-tools.sh" ]]; then
  # shellcheck source=scripts/nikos-tools.sh
  source "${NIKOS_HOME}/scripts/nikos-tools.sh"
  _TOOLS_LIB_LOADED=true
fi

if [[ -f "${REPO_SYNC_HELPERS}" ]]; then
  # shellcheck source=/dev/null
  source "${REPO_SYNC_HELPERS}"
fi

# Progress rendering, shared with install.sh. Optional: without it the plain
# scrolling view is used. `nikos setup` and `nikos update` never sourced this at
# all, so post-install runs showed raw `TASK [...]` output on any terminal -
# the same symptom as the install defect, a different cause.
_PROGRESS_LIB_LOADED=false
if [[ -f "${PROGRESS_LIB}" ]]; then
  # shellcheck source=scripts/nikos-progress.sh
  source "${PROGRESS_LIB}"
  _PROGRESS_LIB_LOADED=true
fi

# Returns 0 when the per-role gauge can be drawn for this run.
_can_use_gauge() {
  [[ "${USE_DIALOG}" != "0" ]] || return 1
  [[ "${_PROGRESS_LIB_LOADED}" == "true" ]] || return 1
  nikos_progress_supported
}

_restore_terminal_cursor() {
  if [[ -e /dev/tty ]] && { : >/dev/tty; } 2>/dev/null; then
    { tput cnorm 2>/dev/null || printf '\033[?25h'; } >/dev/tty 2>/dev/null || true
  fi
}

_cleanup_become_password_file() {
  if [[ -n "${BECOME_PASSWORD_FILE:-}" && -f "${BECOME_PASSWORD_FILE}" ]]; then
    rm -f -- "${BECOME_PASSWORD_FILE}"
  fi
  BECOME_PASSWORD_FILE=""
}
# Refreshes the sudo timestamp the password check just created, so a direct
# sudo call later in the same command (dialog install, a helper) does not ask
# again. Ansible itself reads the password file. Ends on its own when this
# process is gone or sudo stops accepting -n; _cleanup_run stops it on every
# exit path.
_start_sudo_keepalive() {
  local parent=$$
  [[ -z "${SUDO_KEEPALIVE_PID}" ]] || return 0
  (
    trap - EXIT INT TERM
    while sleep 60; do
      kill -0 "${parent}" 2>/dev/null || exit 0
      sudo -n -v </dev/null >/dev/null 2>&1 || exit 0
    done
  ) </dev/null >/dev/null 2>&1 &
  SUDO_KEEPALIVE_PID=$!
}

_stop_sudo_keepalive() {
  if [[ -n "${SUDO_KEEPALIVE_PID}" ]]; then
    kill "${SUDO_KEEPALIVE_PID}" 2>/dev/null || true
    wait "${SUDO_KEEPALIVE_PID}" 2>/dev/null || true
  fi
  SUDO_KEEPALIVE_PID=""
}

# One cleanup for both things an interrupted run leaves behind: the password
# file, and the cursor, which dialog hides while the gauge is drawing. Without
# the second, Ctrl-C during `nikos update` returns an invisible prompt.
# install.sh's _cleanup_install pairs them for the same reason.
_cleanup_run() {
  _stop_sudo_keepalive
  # The password check left a sudo timestamp on this terminal and the
  # keepalive kept it fresh. Drop it, so sudo asks again after this command.
  if [[ "${NIKOS_BECOME_MODE}" == "file" ]]; then
    sudo -k </dev/null >/dev/null 2>&1 || true
  fi
  _cleanup_become_password_file
  _restore_terminal_cursor
}

trap '_cleanup_run' EXIT
trap '_cleanup_run; exit 130' INT
trap '_cleanup_run; exit 143' TERM

# Says once, on the terminal and in the log, why the run shows plain Ansible
# output instead of the gauge. A silent fallback looks like a broken installer.
_plain_view_notice() {
  local reason=""
  if [[ "${USE_DIALOG}" == "0" ]]; then
    reason="NIKOS_USE_DIALOG=0"
  elif [[ "${_PROGRESS_LIB_LOADED}" == "true" ]]; then
    reason="$(nikos_progress_why_not)"
  else
    reason="${PROGRESS_LIB} not found"
  fi
  reason="${reason:-unknown}"
  print_info "Plain progress view: ${reason}"
  _logfile "Plain progress view: ${reason}"
}

# The gauge needs dialog. Offer to install it, as install.sh's bootstrap does,
# when a person is there to answer and apt-get exists. Default is no.
_offer_dialog_install() {
  local answer=""
  [[ "${USE_DIALOG}" != "0" ]] || return 0
  command -v dialog >/dev/null 2>&1 && return 0
  command -v apt-get >/dev/null 2>&1 || return 0
  [[ -e /dev/tty ]] && { : >/dev/tty; } 2>/dev/null || return 0
  printf 'dialog is not installed; install it for the progress view? [y/N] ' >/dev/tty
  read -r answer </dev/tty || answer=""
  case "${answer}" in
    y|Y|yes|YES) sudo apt-get install -y dialog || print_warn "Could not install dialog." ;;
  esac
  return 0
}

# Asks for the sudo password in a dialog box. $1 is the attempt number: from
# the second on, the box says the last answer was wrong. Prints the answer.
# Returns 4 when dialog could not draw (DIALOG_ERROR; by default that is 255,
# the same as Esc) and another non-zero code when the user cancels.
_become_password_box() {
  local text="Sudo password for ${USER:-$(id -un)}. It is asked once and used for the whole command."
  (( $1 > 1 )) && text="Sorry, try again.\n\n${text}"
  DIALOG_ERROR=4 dialog --keep-tite --stdout --title "NikOS ${NIKOS_VERSION}: sudo password" \
    --passwordbox "${text}" 10 66 </dev/tty 2>/dev/tty
}

# ansible's own --ask-become-pass prompt reads /dev/tty, which the gauge is
# drawing the mixedgauge on at the same moment. Collect the password first and
# hand it over in a file, as install.sh does. Returns 3 when the user cancelled
# the box, which ends the command. Another non-zero code means it could not be
# collected, which drops the run back to --ask-become-pass; the reason is left
# in NIKOS_PROGRESS_SKIP_REASON for the plain-view notice.
#
# Each answer is checked with `sudo -S -v`, fed on stdin (never argv), so a
# typo is caught here with three tries instead of failing the playbook later.
_collect_become_password() {
  local pw="" attempt use_box=false box_rc

  [[ -e /dev/tty ]] || { NIKOS_PROGRESS_SKIP_REASON="no controlling terminal /dev/tty"; return 1; }
  # The same condition as the gauge: a run that draws the gauge asks in a box.
  _can_use_gauge && use_box=true
  for attempt in 1 2 3; do
    if [[ "${use_box}" == true ]]; then
      box_rc=0
      pw="$(_become_password_box "${attempt}")" || box_rc=$?
      _leave_box
      # dialog could not draw: ask with the plain prompt from here on.
      (( box_rc != 4 )) || use_box=false
      # 3: the user cancelled, which ends the command instead of falling back
      # to ansible's own prompt.
      (( box_rc == 0 || box_rc == 4 )) || return 3
    fi
    if [[ "${use_box}" != true ]]; then
      printf 'Sudo password for %s: ' "${USER:-$(id -un)}" >/dev/tty 2>/dev/null ||
        { NIKOS_PROGRESS_SKIP_REASON="no controlling terminal /dev/tty"; return 1; }
      if ! read -rs pw </dev/tty; then
        printf '\n' >/dev/tty
        NIKOS_PROGRESS_SKIP_REASON="empty sudo password"
        return 1
      fi
      printf '\n' >/dev/tty
    fi
    if [[ -z "${pw}" ]]; then
      NIKOS_PROGRESS_SKIP_REASON="empty sudo password"
      return 1
    fi
    # `sudo -k` runs on its own, then plain `-S -v`, with no -p: one flag per
    # call keeps the check off option combinations where sudo 1.9 and sudo-rs
    # (the default sudo on Ubuntu 26.04) may differ. Output is discarded anyway.
    sudo -k </dev/null >/dev/null 2>&1 || true
    if printf '%s\n' "${pw}" | sudo -S -v >/dev/null 2>&1; then
      break
    fi
    pw=""
    [[ "${use_box}" == true ]] || { (( attempt < 3 )) && printf 'Sorry, try again.\n' >/dev/tty; }
  done
  if [[ -z "${pw}" ]]; then
    # 2, not 1: a fourth try through --ask-become-pass would only repeat this.
    NIKOS_PROGRESS_SKIP_REASON="sudo password rejected 3 times"
    return 2
  fi

  # Each step is checked on its own. The caller reads a non-zero return as
  # "fall back to --ask-become-pass", and errexit is suspended inside the `if`
  # condition it is called from, so an unchecked failure here would neither
  # abort nor return - it would carry on and hand ansible a --become-password-file
  # that is empty, unwritten or truncated.
  #
  # The path is registered in BECOME_PASSWORD_FILE the moment the file exists,
  # because the INT/TERM trap can only remove what that global names. Holding it
  # in a local until the write succeeded left a window where an interrupt would
  # strand a mode-600 file containing the sudo password on disk. Every failure
  # after this point cleans up explicitly, so a failed collection still leaves
  # nothing behind and still returns non-zero. The remaining window strands an
  # empty file, never the password.
  _cleanup_become_password_file
  if ! BECOME_PASSWORD_FILE="$(mktemp "${TMPDIR:-/tmp}/nikos-become.XXXXXX")" ||
    [[ -z "${BECOME_PASSWORD_FILE}" ]]; then
    BECOME_PASSWORD_FILE=""
    print_error "Could not create a temporary file for the sudo password."
    unset pw
    return 1
  fi
  # mktemp already creates at 0600, so chmod is belt and braces - but a failure
  # is still fatal here rather than left to widen the file silently.
  if ! chmod 600 "${BECOME_PASSWORD_FILE}"; then
    print_error "Could not restrict access to ${BECOME_PASSWORD_FILE}; the sudo password was not written to it."
    _cleanup_become_password_file
    unset pw
    return 1
  fi
  if ! printf '%s\n' "${pw}" > "${BECOME_PASSWORD_FILE}"; then
    print_error "Could not write the sudo password to ${BECOME_PASSWORD_FILE}."
    _cleanup_become_password_file
    unset pw
    return 1
  fi
  unset pw
}

# Decides once per process how ansible gets the sudo password. Sets
# NIKOS_BECOME_MODE to nopass, file (BECOME_PASSWORD_FILE holds a checked
# password, so `nikos update` asks once although it runs the playbook twice)
# or ask (no terminal, or an empty answer: ansible prompts itself on each
# run). Returns 1 when sudo rejected the password three times and 130 when
# the user cancelled the password box.
_ensure_become_password() {
  if [[ "${NIKOS_BECOME_MODE}" == "ask" ]]; then
    NIKOS_PROGRESS_SKIP_REASON="${NIKOS_BECOME_ASK_REASON}"
    return 0
  fi
  if [[ "${NIKOS_BECOME_MODE}" == "file" && -s "${BECOME_PASSWORD_FILE:-}" ]] ||
    [[ "${NIKOS_BECOME_MODE}" == "nopass" ]]; then
    return 0
  fi
  # Cached credentials are dropped first: the cache is per terminal, so the
  # sudo ansible runs would not see it and the play would fail midway. -k runs
  # on its own, not combined with -n, for sudo-rs (see _collect_become_password).
  sudo -k </dev/null >/dev/null 2>&1 || true
  if sudo -n true </dev/null >/dev/null 2>&1; then
    NIKOS_BECOME_MODE="nopass"
    return 0
  fi
  local pw_rc=0
  _collect_become_password || pw_rc=$?
  if (( pw_rc == 0 )); then
    NIKOS_BECOME_MODE="file"
    _start_sudo_keepalive
  elif (( pw_rc == 2 )); then
    print_error "Sudo rejected the password three times; the playbook did not run."
    _logfile "[FAILED] sudo password rejected 3 times"
    return 1
  elif (( pw_rc == 3 )); then
    print_info "Cancelled at the sudo password; the playbook did not run."
    _logfile "[CANCELLED] at the sudo password"
    return 130
  else
    NIKOS_PROGRESS_SKIP_REASON="${NIKOS_PROGRESS_SKIP_REASON:-could not store the sudo password}"
    NIKOS_BECOME_ASK_REASON="${NIKOS_PROGRESS_SKIP_REASON}"
    NIKOS_BECOME_MODE="ask"
  fi
}

# Every command the CLI accepts, one row each. Fields, separated by ";":
#   command   first word, as the dispatch below matches it
#   synopsis  what usage() prints after "nikos "
#   menu      argv the menu runs; {Prompt} asks for one word, "-" keeps the
#             row out of the menu
#   changes   yes: changes the system, so the menu asks before running it
#   about     one-line description
# usage() and the menu are both built from this table; a test fails when the
# dispatch has a command the table does not.
NIKOS_COMMANDS=(
  "setup;setup;setup;yes;Run full NikOS playbook (first install)"
  "update;update;update;yes;Move to the newest release, then re-run playbook (idempotent)"
  "update;update --ref <r>;update --ref {Branch or tag};yes;Update to a specific branch or tag instead"
  "add;add tools;add tools;yes;Choose distrodeck tools by category and install them"
  "add;add <name>;add {Optional role};yes;Install optional role: network | music | education | neovim | java | bun | redis | postgres | mongodb | qdrant | k8s-tools | podman | zsh | act | fabric | jev | antigravity | bitnet | mistral-rs | monitoring | openclaw"
  "add;add ollama-<m>;add ollama-{Role: text, reasoning, coding, vision, embedding or models};yes;Ollama module, this machine's model per role: text | reasoning | coding | vision | embedding | models (all)"
  "add;add model <m>;add model {Ollama model};yes;Install an Ollama model outside the approved set; updates keep it"
  "status;status;status;no;Show NikOS version, Ollama models, installed roles"
  "models;models [show];models show;no;This machine's class and approved model per role"
  "models;models prune;models prune;yes;Offer each installed model outside the set for removal"
  "doctor;doctor;doctor;no;Check for broken configs and missing dependencies"
  "clean;clean;clean;no;Dry run: list old Docker build cache, idle node_modules and unused package caches"
  "clean;clean --apply;clean --apply;yes;Free that disk space; never Docker volumes"
  "hooks;hooks;hooks;no;Security hooks: status of the tools and every clone you own"
  "hooks;hooks apply;hooks apply;yes;Set them up in your clones (--dry-run, --batch N, --agents)"
  "hooks;hooks --global;hooks --global;yes;Machine-wide git hooks (opt-in; install/update never run it)"
  "hooks;hooks export|import DIR;-;yes;Carry the setup to another computer"
  "log;log [N];log;no;Show last N lines of the latest playbook log (default 50)"
  "log;log list;log list;no;List available log files"
  "help;help;-;no;Show this message"
)

# Splits one NIKOS_COMMANDS row into _cmd_name, _cmd_synopsis, _cmd_menu,
# _cmd_changes and _cmd_about. The description may contain ";", so the first
# four fields are taken from the front.
_command_row() {
  local rest="$1"
  _cmd_name="${rest%%;*}"; rest="${rest#*;}"
  _cmd_synopsis="${rest%%;*}"; rest="${rest#*;}"
  _cmd_menu="${rest%%;*}"; rest="${rest#*;}"
  _cmd_changes="${rest%%;*}"; _cmd_about="${rest#*;}"
}

usage() {
  local row
  printf 'nikos %s - Neural Innovation for Knowledge OS\n\nUsage:\n' "${NIKOS_VERSION}"
  for row in "${NIKOS_COMMANDS[@]}"; do
    _command_row "${row}"
    printf '  nikos %-24s %s\n' "${_cmd_synopsis}" "${_cmd_about}"
  done
}

# True when bare `nikos` should open the menu rather than print usage: stdin
# and stdout are a terminal, dialog is installed, and NIKOS_USE_DIALOG is not 0.
_menu_available() {
  [[ -t 0 && -t 1 && "${USE_DIALOG}" != "0" && "${TERM:-dumb}" != "dumb" ]] &&
    command -v dialog >/dev/null 2>&1
}

# Fills each {Prompt} of a menu template from a dialog input box and prints
# the argv, one word per line. Returns 1 when the user cancels, or gives an
# empty value or one with spaces (each prompt stands for one word).
_menu_argv() {
  local template="$1" word prompt value pre post
  local -a words
  # Template words are split on spaces; a {Prompt} may contain spaces, so
  # they are rejoined until the closing brace.
  read -r -a words <<<"${template}"
  local i=0 n=${#words[@]}
  while (( i < n )); do
    word="${words[i]}"
    while [[ "${word}" == *"{"* && "${word}" != *"}"* ]] && (( i + 1 < n )); do
      i=$((i + 1)); word="${word} ${words[i]}"
    done
    while [[ "${word}" == *"{"*"}"* ]]; do
      pre="${word%%\{*}"; prompt="${word#*\{}"; prompt="${prompt%%\}*}"; post="${word#*\}}"
      value="$(dialog --stdout --inputbox "${prompt}" 8 70 "" 2>/dev/tty)" || return 1
      [[ -n "${value}" && "${value}" != *[[:space:]]* ]] || return 1
      word="${pre}${value}${post}"
    done
    printf '%s\n' "${word}"
    i=$((i + 1))
  done
}

# The menu bare `nikos` opens on a terminal. Each choice runs as a child
# process, so a command that exits comes back here; Exit or Esc leaves.
cmd_menu() {
  local -a items=() rows=() argv=()
  local row choice rc i=0
  for row in "${NIKOS_COMMANDS[@]}"; do
    _command_row "${row}"
    [[ "${_cmd_menu}" == "-" ]] && continue
    i=$((i + 1)); rows[i]="${row}"
    items+=("${i}" "${_cmd_synopsis}: ${_cmd_about}")
  done
  while true; do
    # DIALOG_ERROR gives a failed dialog (a terminal too small to draw on) an
    # exit code of its own; by default it is 255, the same as Esc.
    rc=0
    choice="$(DIALOG_ERROR=3 dialog --stdout --title "NikOS ${NIKOS_VERSION}" --cancel-label "Exit" \
      --menu "Choose a command" 22 100 14 "${items[@]}" 2>/dev/tty)" || rc=$?
    if (( rc == 3 )); then
      clear
      usage
      return 0
    fi
    (( rc == 0 )) || break
    _command_row "${rows[choice]}"
    argv=()
    while IFS= read -r row; do argv+=("${row}"); done < <(_menu_argv "${_cmd_menu}"; echo "rc=$?")
    [[ "${argv[${#argv[@]}-1]}" == "rc=0" ]] || continue
    unset 'argv[${#argv[@]}-1]'
    if [[ "${_cmd_changes}" == "yes" ]]; then
      dialog --yesno "Run 'nikos ${argv[*]}'? It changes this system." 7 70 2>/dev/tty || continue
    fi
    clear
    rc=0
    bash "${NIKOS_CLI_PATH}" "${argv[@]}" || rc=$?
    printf '\n[nikos %s finished, exit %s] Press Enter to return to the menu. ' "${argv[*]}" "${rc}"
    read -r _ </dev/tty || true
  done
  clear
}

_get_default_skip_tags() {
  local skip_tags="${NIKOS_SKIP_TAGS:-}"

  if [[ -n "${skip_tags}" ]]; then
    printf '%s\n' "${skip_tags#,}"
    return 0
  fi

  if [[ -f "${SELECTIONS_FILE}" ]]; then
    # shellcheck source=/dev/null
    source "${SELECTIONS_FILE}"
    printf '%s\n' "${NIKOS_SKIP_TAGS_SAVED:-}"
  else
    printf '\n'
  fi

  return 0
}

_save_skip_tags() {
  local optional_tags="${2:-}" migrated="${3:-}" tools="${NIKOS_TOOLS_TO_SAVE-}"
  # The distrodeck tool list rides along unchanged unless the caller sets
  # NIKOS_TOOLS_TO_SAVE, so rewriting the skip tags can never drop it.
  if [[ -z "${NIKOS_TOOLS_TO_SAVE+set}" && -f "${SELECTIONS_FILE}" ]]; then
    # shellcheck source=/dev/null
    tools="$(source "${SELECTIONS_FILE}"; printf '%s' "${NIKOS_DISTRODECK_TOOLS_SAVED:-}")"
  fi
  if [[ $# -lt 3 && -f "${SELECTIONS_FILE}" ]]; then
    # shellcheck source=/dev/null
    source "${SELECTIONS_FILE}"
    [[ $# -lt 2 ]] && optional_tags="${NIKOS_EXPLICIT_OPTIONAL_TAGS_SAVED:-}"
    migrated="${NIKOS_OPTIONAL_TAGS_MIGRATED:-}"
  fi
  mkdir -p "${NIKOS_CONFIG_DIR}"
  {
    printf "NIKOS_SKIP_TAGS_SAVED=%q\n" "${1}"
    printf "NIKOS_EXPLICIT_OPTIONAL_TAGS_SAVED=%q\n" "${optional_tags}"
    printf "NIKOS_OPTIONAL_TAGS_MIGRATED=%q\n" "${migrated}"
    printf "NIKOS_DISTRODECK_TOOLS_SAVED=%q\n" "${tools}"
  } > "${SELECTIONS_FILE}"
}

_migrate_saved_optional_tags() {
  local skip_tags optional_tags="" tag
  local -a optional_role_tags=(
    neovim java bun redis postgres mongodb qdrant k8s-tools podman zsh act fabric jev
    antigravity bitnet mistral-rs monitoring openclaw ollama-models ollama-reasoning
    ollama-coding ollama-text ollama-vision ollama-embedding
  )

  [[ -f "${SELECTIONS_FILE}" ]] || return 0
  # shellcheck source=/dev/null
  source "${SELECTIONS_FILE}"
  [[ -n "${NIKOS_EXPLICIT_OPTIONAL_TAGS_SAVED:-}" || "${NIKOS_OPTIONAL_TAGS_MIGRATED:-}" == "1" ]] && return 0

  skip_tags="${NIKOS_SKIP_TAGS_SAVED:-}"
  for tag in "${optional_role_tags[@]}"; do
    if grep -Eq -- "(^|,|[[:space:]])${tag}(,|[[:space:]]|$)" "${NIKOS_LOG_DIR}"/*.log 2>/dev/null; then
      optional_tags="${optional_tags:+${optional_tags},}${tag}"
    fi
  done
  _save_skip_tags "${skip_tags}" "${optional_tags}" "1"
}

# One-time move of Antigravity to the snaps. Until this release the IDE came
# through distrodeck from Google's apt repository, which stopped at 1.23.2. A
# desktop that has that package, or `antigravity` in its saved distrodeck list,
# gets the antigravity bundle added to its selection, so the optional replay
# of `nikos update` installs the snaps and removes the package. A server is
# left alone: the role does not run there. No-op once the bundle is selected.
_migrate_antigravity_to_snap() {
  local tools status
  [[ "$(_nikos_var nikos_profile desktop)" == "desktop" ]] || return 0
  case ",$(_get_saved_optional_tags)," in
    *,antigravity,*) return 0 ;;
  esac
  tools="$(_get_saved_tools)"
  status="$(dpkg-query -W -f='${Status}' antigravity 2>/dev/null || true)"
  if [[ ",${tools}," == *",antigravity,"* || "${status}" == "install ok installed" ]]; then
    print_info "Antigravity moves from Google's apt package (stale at 1.23.2) to the snaps: adding the antigravity bundle."
    _logfile "Antigravity: apt package or saved distrodeck tool found; antigravity bundle added to the selection" 2>/dev/null || true
    _add_optional_tag antigravity
  fi
}

_get_saved_optional_tags() {
  _migrate_saved_optional_tags
  if [[ -f "${SELECTIONS_FILE}" ]]; then
    # shellcheck source=/dev/null
    source "${SELECTIONS_FILE}"
    printf "%s\n" "${NIKOS_EXPLICIT_OPTIONAL_TAGS_SAVED:-}"
  else
    printf "\n"
  fi
}


_get_saved_tools() {
  [[ -f "${SELECTIONS_FILE}" ]] || { printf '\n'; return 0; }
  # shellcheck source=/dev/null
  ( source "${SELECTIONS_FILE}"; printf '%s\n' "${NIKOS_DISTRODECK_TOOLS_SAVED:-}" )
}

# _save_tools <csv> - replaces the saved distrodeck tool list, keeping the rest.
_save_tools() {
  local skip optional migrated=""
  skip="$(_get_default_skip_tags)"
  if [[ -f "${SELECTIONS_FILE}" ]]; then
    # shellcheck source=/dev/null
    optional="$(source "${SELECTIONS_FILE}"; printf '%s' "${NIKOS_EXPLICIT_OPTIONAL_TAGS_SAVED:-}")"
    # shellcheck source=/dev/null
    migrated="$(source "${SELECTIONS_FILE}"; printf '%s' "${NIKOS_OPTIONAL_TAGS_MIGRATED:-}")"
  fi
  NIKOS_TOOLS_TO_SAVE="$1" _save_skip_tags "${skip}" "${optional:-}" "${migrated}"
}

_add_optional_tag() {
  local tag="$1" optional_tags
  optional_tags="$(_get_saved_optional_tags)"
  case ",${optional_tags}," in
    *,"${tag}",*) return 0 ;;
  esac
  optional_tags="${optional_tags:+${optional_tags},}${tag}"
  _save_skip_tags "$(_get_default_skip_tags)" "${optional_tags}"
}

_remove_skip_tag() {
  local tag="$1"
  local skip_tags item
  local updated=()

  skip_tags="$(_get_default_skip_tags)"
  IFS=, read -r -a items <<< "${skip_tags}"
  for item in "${items[@]}"; do
    [[ -z "${item}" || "${item}" == "${tag}" ]] && continue
    updated+=("${item}")
  done

  _save_skip_tags "$(IFS=,; echo "${updated[*]}")"
}

_playbook() {
  local use_saved_skip_tags=true
  if [[ "${1:-}" == "--no-saved-skip-tags" ]]; then
    use_saved_skip_tags=false
    shift
  fi
  local extra_args=("$@")
  local skip_tags=""
  local use_gauge=false
  local playbook_args=(
    -i "${NIKOS_HOME}/inventory/local"
    "${NIKOS_HOME}/site.yml"
  )
  if [[ ! -d "${NIKOS_HOME}/.git" ]]; then
    print_error "NikOS repo not found at ${NIKOS_HOME}. Run the installer first."
    exit 1
  fi
  if [[ ! -f "${ANSIBLE_REQUIREMENTS}" ]]; then
    print_error "Ansible collection requirements file not found at ${ANSIBLE_REQUIREMENTS}."
    exit 1
  fi
  # The run log is opened before the collections install: in the gauge view that
  # step draws a box and its output goes here, ahead of the playbook's.
  local run_log
  run_log="${NIKOS_LOG_DIR}/nikos-$(date +%Y%m%d-%H%M%S)-playbook.log"
  mkdir -p "${NIKOS_LOG_DIR}"
  NIKOS_LAST_RUN_LOG=""

  local -a collections_cmd=()
  if [[ -f "${NIKOS_HOME}/scripts/install-collections.sh" ]]; then
    collections_cmd=(bash "${NIKOS_HOME}/scripts/install-collections.sh" "${ANSIBLE_REQUIREMENTS}")
  else
    collections_cmd=(ansible-galaxy collection install --no-cache -r "${ANSIBLE_REQUIREMENTS}")
  fi
  local collections_rc=0 collections_boxed=false
  if _can_use_gauge; then
    collections_boxed=true
    _logfile "Installing required Ansible collections (log: ${run_log})"
    _boxed_step "Installing required Ansible collections..." "${run_log}" "${collections_cmd[@]}" || collections_rc=$?
  else
    print_info "Installing required Ansible collections..."
    "${collections_cmd[@]}" || collections_rc=$?
  fi
  # Checked, not left to set -e: a caller that runs `_playbook || rc=$?`
  # suspends errexit, and the playbook would run without the collections.
  if (( collections_rc != 0 )); then
    if [[ "${collections_boxed}" == true ]] && (( collections_rc == 74 )); then
      print_error "The Ansible collections installed, but the log ${run_log} could not be written; the playbook did not run. Check disk space and permissions, then rerun."
    else
      [[ "${collections_boxed}" != true ]] || _boxed_step_tail "${run_log}"
      print_error "Failed to install required Ansible collections (exit ${collections_rc}); the playbook did not run."
      { echo "[FAILED] ansible collections install (rc=${collections_rc})" >>"${run_log}"; } 2>/dev/null || true
    fi
    _logfile "[FAILED] ansible collections install (rc=${collections_rc})"
    if [[ -e "${run_log}" ]]; then
      _publish_run_log "${run_log}"
      NIKOS_LAST_RUN_LOG="${run_log}"
    fi
    return "${collections_rc}"
  fi
  if [[ "${use_saved_skip_tags}" == "true" ]]; then
    skip_tags="$(_get_default_skip_tags)"
  fi
  [[ -n "${skip_tags}" ]] && playbook_args+=(--skip-tags "${skip_tags}")
  playbook_args+=(-e "nikos_distrodeck_tools=$(_get_saved_tools)")
  playbook_args+=("${extra_args[@]}")

  # ask_pass: ansible prompts on the terminal itself, so only that plain run
  # keeps the tty as stdin. Every other run gets /dev/null: ansible-core aborts
  # on a non-blocking stdin, which dialog can leave behind.
  local ask_pass=false
  NIKOS_PROGRESS_SKIP_REASON=""
  # Before the dialog offer: its `sudo apt-get install` then runs on the
  # checked password instead of asking for it a second time.
  local become_rc=0
  _ensure_become_password || become_rc=$?
  # 130: cancelled at the password box, and said so there. The command ends
  # here: nothing has run, and a caller must not report a failed playbook.
  (( become_rc != 130 )) || exit 130
  (( become_rc == 0 )) || return "${become_rc}"
  _offer_dialog_install
  case "${NIKOS_BECOME_MODE}" in
    file) playbook_args+=(--become-password-file "${BECOME_PASSWORD_FILE}") ;;
    ask) playbook_args+=(--ask-become-pass) ;;
  esac
  if [[ "${NIKOS_BECOME_MODE}" != "ask" ]] && _can_use_gauge; then
    use_gauge=true
  fi
  if [[ "${use_gauge}" != "true" ]]; then
    [[ "${NIKOS_BECOME_MODE}" == "ask" ]] && ask_pass=true
    _plain_view_notice
  fi

  _logfile "Playbook start: ansible-playbook ${playbook_args[*]}"
  _logfile "--- ansible-playbook output start ---"

  local _rc=0 ansible_rc=0 tee_rc=0
  local -a pipe_status=()
  # nikos_progress_run renders against the role list and task total that
  # nikos_progress_plan produces. Without the planner NIKOS_PROGRESS_TOTAL stays
  # zero, the percentage is never computed, and the gauge sits at 0% until
  # PLAY RECAP jumps it to 100 - a progress bar that does not report progress.
  # install.sh plans first for the same reason, and drops to the plain view when
  # the task list cannot be produced.
  if [[ "${use_gauge}" == "true" ]]; then
    declare -F dialog_init >/dev/null 2>&1 && dialog_init
    if ! nikos_progress_plan "${NIKOS_HOME}" "${NIKOS_HOME}/ansible.cfg" "${playbook_args[@]}"; then
      use_gauge=false
      _plain_view_notice
    fi
  fi

  _publish_run_log "${run_log}"

  set +e
  if [[ "${use_gauge}" == "true" ]]; then
    nikos_progress_run "NikOS ${NIKOS_VERSION} — Playbook" "${run_log}" \
      "${NIKOS_HOME}" "${NIKOS_HOME}/ansible.cfg" "${playbook_args[@]}"
    ansible_rc=$?
    # A run whose log could not be written is reported as that, not as a failed
    # playbook: nikos_progress_run folds the log failure into its own status.
    tee_rc="${NIKOS_PROGRESS_LOG_RC:-0}"
    if [[ "${tee_rc}" -ne 0 && "${ansible_rc}" -eq "${tee_rc}" ]]; then
      ansible_rc=0
    fi
    _restore_terminal_cursor
    _leave_tui
  elif [[ "${ask_pass}" == "true" ]]; then
    (
      cd "${NIKOS_HOME}"
      ANSIBLE_CONFIG="${NIKOS_HOME}/ansible.cfg" ANSIBLE_NOCOLOR=1 ANSIBLE_FORCE_COLOR=0 \
        ansible-playbook "${playbook_args[@]}"
    ) 2>&1 | tee -a "${run_log}"
    pipe_status=("${PIPESTATUS[@]}")
    ansible_rc=${pipe_status[0]}
    tee_rc=${pipe_status[1]}
  else
    (
      cd "${NIKOS_HOME}"
      ANSIBLE_CONFIG="${NIKOS_HOME}/ansible.cfg" ANSIBLE_NOCOLOR=1 ANSIBLE_FORCE_COLOR=0 \
        ansible-playbook "${playbook_args[@]}" </dev/null
    ) 2>&1 | tee -a "${run_log}"
    pipe_status=("${PIPESTATUS[@]}")
    ansible_rc=${pipe_status[0]}
    tee_rc=${pipe_status[1]}
  fi
  set -e
  # The password file stays for the next _playbook call of this command
  # (`nikos update` runs the playbook twice); the EXIT trap removes it.

  if [[ "${ansible_rc}" -ne 0 ]]; then
    _rc="${ansible_rc}"
  elif [[ "${tee_rc}" -ne 0 ]]; then
    print_error "Failed to write playbook log to ${run_log}."
    _logfile "[FAILED] tee could not write ${run_log} (rc=${tee_rc})"
    _rc="${tee_rc}"
  fi

  _logfile "--- ansible-playbook output end ---"
  # Failed tasks, warnings and the environment at the end of the run log; see
  # nikos_log_digest in scripts/nikos-progress.sh.
  if declare -F nikos_log_digest >/dev/null; then
    # Read fully first: appending while the digest still reads the same file
    # could feed it its own output.
    local digest
    digest="$(nikos_log_digest "${run_log}" "${NIKOS_HOME}" 2>/dev/null)" || true
    [[ -z "${digest}" ]] || printf '%s\n' "${digest}" >>"${run_log}"
  fi
  _playbook_summary "${run_log}" "${_rc}" "${use_gauge}"
  NIKOS_LAST_RUN_LOG="${run_log}"

  return "${_rc}"
}

# The distrodeck NikOS installed, or the one on PATH.
_distrodeck_bin() {
  # NikOS's own clone (nikos_tools_dir). Never ~/Projects/distrodeck: that may
  # be the user's own working copy. Before the playbook has re-run, the
  # /usr/local/bin/distrodeck wrapper found below still points at the old clone.
  if [[ -x "${HOME}/.local/share/nikos-tools/distrodeck/distrodeck" ]]; then
    printf '%s\n' "${HOME}/.local/share/nikos-tools/distrodeck/distrodeck"
  else
    command -v distrodeck
  fi
}

# Offers distrodeck's catalog by category and saves the answer. Returns 0 with
# nothing changed when there is no terminal or the installed distrodeck has no
# catalog; returns non-zero only when the user cancels.
_select_tools() {
  local bin catalog saved
  [[ "${_TOOLS_LIB_LOADED}" == "true" ]] || return 0
  if ! [[ -e /dev/tty ]] || ! { : >/dev/tty; } 2>/dev/null; then
    return 0
  fi
  saved="$(_get_saved_tools)"
  if ! bin="$(_distrodeck_bin)" || ! catalog="$(nikos_tools_catalog "${bin}")"; then
    print_info "This distrodeck has no tool catalog (install-tools --list-catalog); skipping tool selection."
    return 0
  fi
  NIKOS_SELECTED_TOOLS="${saved}"
  if [[ "${USE_DIALOG}" != "0" ]] && command -v dialog >/dev/null 2>&1; then
    declare -F dialog_init >/dev/null 2>&1 && dialog_init
    nikos_tools_select_dialog "${catalog}" "${saved}" || return $?
    _restore_terminal_cursor
  else
    nikos_tools_select_plain "${catalog}" "${saved}" || return $?
  fi
  _save_tools "${NIKOS_SELECTED_TOOLS}"
  print_info "distrodeck tools: ${NIKOS_SELECTED_TOOLS:-none}"
}

cmd_setup() {
  _select_tools || { print_error "Tool selection canceled; nothing was run."; exit 130; }
  print_info "Running full NikOS setup..."
  _playbook -e nikos_update_mode=false
}

# After a release upgrade the process running this function is the copy that the
# *previous* release left at /usr/local/bin/nikos (site.yml installs the CLI by
# copying scripts/nikos there). Bash parsed that old cmd_update long before the
# new checkout existed, so anything the new release adds to the update flow -
# the optional-bundle replay below, for one - would not run until a second
# `nikos update`. Hand the rest of the update to the CLI that was just checked
# out. NIKOS_UPDATE_CONTINUATION tells that process the checkout is already
# synced, which is also what stops this from recursing.
_exec_update_continuation() {
  local new_cli="${NIKOS_HOME}/scripts/nikos"

  [[ -f "${new_cli}" ]] || return 0
  if cmp -s "${new_cli}" "${NIKOS_CLI_PATH}" 2>/dev/null; then
    return 0
  fi

  print_info "Continuing the update with the newly checked-out NikOS CLI..."
  NIKOS_UPDATE_CONTINUATION=1 exec bash "${new_cli}" update
}

cmd_update() {
  local update_rc=0
  local target_ref="${1:-}"

  if [[ "${NIKOS_UPDATE_CONTINUATION:-}" == "1" ]]; then
    # The CLI that exec'd us already synced the checkout to its target ref.
    :
  elif [[ -d "${NIKOS_HOME}/.git" ]]; then
    if ! declare -F _sync_repo_to_ref >/dev/null; then
      print_error "Repo sync helper at ${REPO_SYNC_HELPERS} is from an older NikOS release. Reinstall NikOS to refresh it."
      exit 1
    fi

    # A tag install advances to the newest release; a branch install stays on
    # its branch. Without this, an update would leave a detached HEAD with
    # nothing to fast-forward.
    if [[ -z "${target_ref}" ]]; then
      target_ref="$(_resolve_update_ref "${REPO_URL}" "${NIKOS_HOME}")"
    fi

    local sync_text sync_log=""
    if [[ -n "${target_ref}" ]]; then
      sync_text="Updating NikOS repo and submodules to ${target_ref}..."
    else
      sync_text="Already on the newest NikOS release; refreshing submodules..."
    fi

    # The same condition as the gauge: a run that draws it syncs behind a box,
    # with the git output in its own log, unless ssh could prompt (see
    # _sync_may_ask_over_ssh). GIT_TERMINAL_PROMPT=0 fails an HTTPS credential
    # prompt instead of drawing it across the box. BatchMode covers an ssh
    # submodule that only the target ref declares, which the check cannot see
    # before the fetch; it is added to the user's own ssh command, not over it.
    if _can_use_gauge && ! _sync_may_ask_over_ssh; then
      local ssh_command
      ssh_command="$(_sync_ssh_command)"
      sync_log="${NIKOS_LOG_DIR}/nikos-$(date +%Y%m%d-%H%M%S)-sync.log"
      _logfile "${sync_text} (log: ${sync_log})" 2>/dev/null || true
      GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${ssh_command} -o BatchMode=yes" \
        _boxed_step "${sync_text}" "${sync_log}" \
        _sync_repo_to_ref "${target_ref}" "nikos-update-autostash" || update_rc=$?
    else
      print_info "${sync_text}"
      _sync_repo_to_ref "${target_ref}" "nikos-update-autostash" || update_rc=$?
    fi
    if [[ "${update_rc}" -ne 0 ]]; then
      if [[ -n "${sync_log}" && "${update_rc}" -ne 74 ]]; then
        _boxed_step_tail "${sync_log}"
        if _sync_log_shows_auth_failure "${sync_log}"; then
          print_info "NIKOS_USE_DIALOG=0 nikos update prints the steps and allows credential prompts."
        fi
      fi
      _logfile "[FAILED] repo sync (rc=${update_rc})" 2>/dev/null || true
      case "${update_rc}" in
        1)
          print_error "Updates were applied, but local changes did not reapply cleanly. Resolve the git conflicts in ${NIKOS_HOME}, then rerun 'nikos update'."
          ;;
        2)
          print_error "Failed to update ${NIKOS_HOME}. Review the git output above, resolve the issue, then rerun 'nikos update'."
          ;;
        74)
          print_error "The repository sync finished, but its log ${sync_log} could not be written. Check disk space and permissions, then rerun 'nikos update'."
          ;;
        3)
          print_error "Failed to update git submodules in ${NIKOS_HOME}. Review the git output above, resolve the issue, then rerun 'nikos update'."
          ;;
        *)
          print_error "Failed to update NikOS repo and submodules in ${NIKOS_HOME}. Review the git output above, then rerun 'nikos update'."
          ;;
      esac
      exit 1
    fi

    _exec_update_continuation
  else
    print_error "NikOS repo not found at ${NIKOS_HOME}. Run the installer first."
    exit 1
  fi

  # Removal first: the space is free before the playbook pulls the set.
  _models_offer_removal
  print_info "Re-running playbook..."
  # Captured, not left to set -e: a failed playbook still gets its own message
  # and exit code, and the optional replay is not run on top of a failure.
  local rc=0
  _playbook -e nikos_update_mode=true || rc=$?
  if [[ "${rc}" -ne 0 ]]; then
    print_error "nikos update failed (exit ${rc}); optional bundles were not refreshed. Log: ${NIKOS_LAST_RUN_LOG:-${NIKOS_LOG_DIR:-~/.config/nikos/logs}}"
    exit "${rc}"
  fi
  local optional_tags
  _migrate_antigravity_to_snap
  optional_tags="$(_get_saved_optional_tags)"
  if [[ -n "${optional_tags}" ]]; then
    print_info "Refreshing selected optional bundles: ${optional_tags}"
    _playbook --no-saved-skip-tags -e nikos_update_mode=true --tags "${optional_tags}" || rc=$?
    if [[ "${rc}" -ne 0 ]]; then
      print_error "Refreshing optional bundles failed (exit ${rc}). Log: ${NIKOS_LAST_RUN_LOG:-${NIKOS_LOG_DIR:-~/.config/nikos/logs}}"
      exit "${rc}"
    fi
  fi
}

cmd_add() {
  local role="${1:-}" bin tools
  case "${role}" in
    model) _add_model "${2:-}" ;;
    tools)
      _select_tools || { print_error "Tool selection canceled; nothing was installed."; exit 130; }
      tools="$(_get_saved_tools)"
      [[ "${_TOOLS_LIB_LOADED}" == "true" ]] && tools="$(nikos_tools_drop_owned "${tools}")"
      if [[ -z "${tools}" ]]; then
        print_info "No distrodeck tools selected. With a distrodeck that has no catalog, 'nikos setup' installs its default set."
        return 0
      fi
      bin="$(_distrodeck_bin)" || { print_error "distrodeck not found. Run 'nikos setup' first."; exit 1; }
      "${bin}" install-tools --tools "${tools}"
      ;;
    network | music | education | neovim | java | bun | redis | postgres | mongodb | qdrant | k8s-tools | podman | zsh | act | fabric | jev | antigravity | bitnet | mistral-rs | monitoring | openclaw | ollama-models | ollama-reasoning | ollama-coding | ollama-text | ollama-vision | ollama-embedding)
      # site.yml skips the desktop layer on a server, so this would report
      # success and install nothing.
      if [[ "${role}" == "music" || "${role}" == "education" || "${role}" == "antigravity" ]] &&
        [[ "$(_nikos_var nikos_profile desktop)" != "desktop" ]]; then
        print_error "${role} is a desktop bundle and this machine's profile is $(_nikos_var nikos_profile desktop) (vars/local.yml)."
        exit 1
      fi
      print_info "Installing optional bundle: ${role}"
      _remove_skip_tag "${role}"
      case "${role}" in
        neovim | java | bun | redis | postgres | mongodb | qdrant | k8s-tools | podman | zsh | act | fabric | jev | antigravity | bitnet | mistral-rs | monitoring | openclaw | ollama-models | ollama-reasoning | ollama-coding | ollama-text | ollama-vision | ollama-embedding)
          _add_optional_tag "${role}"
          ;;
      esac
      _playbook -e nikos_update_mode=false --tags "${role}"
      ;;
    *)
      print_error "Unknown optional role: ${role}"
      echo "Available: network, music, education, neovim, java, bun, redis, postgres, mongodb, qdrant, k8s-tools, podman, zsh, act, fabric, jev, antigravity, bitnet, mistral-rs, monitoring, openclaw, ollama-models, ollama-reasoning, ollama-coding, ollama-text, ollama-vision, ollama-embedding, model <name>"
      exit 1
      ;;
  esac
}

# _nikos_var <name> <default>
#
# Reads a top-level scalar from vars/local.yml, then vars/main.yml - the same
# precedence the playbook uses - so the CLI and the play agree on one value.
# Only `name: value` lines are understood; anything templated falls back.
_nikos_var() {
  local name="$1" default="${2:-}" file value
  for file in "${NIKOS_HOME}/vars/local.yml" "${NIKOS_HOME}/vars/main.yml"; do
    [[ -r "${file}" ]] || continue
    value="$(sed -nE "s/^${name}:[[:space:]]*[\"']?([^\"'#]*[^\"'#[:space:]])?[\"']?[[:space:]]*(#.*)?$/\\1/p" "${file}" | tail -n 1)"
    if [[ -n "${value}" && "${value}" != *"{{"* ]]; then
      printf '%s\n' "${value}"
      return 0
    fi
  done
  printf '%s\n' "${default}"
}

# _os_release_value <KEY>
#
# One value from /etc/os-release (NIKOS_OS_RELEASE_FILE overrides the path,
# as in install.sh). Quotes, CR and surrounding spaces are stripped; a last
# line without a newline still counts. Returns 1 when the key is absent.
_os_release_value() {
  local key="$1" file="${NIKOS_OS_RELEASE_FILE:-/etc/os-release}"
  local line name value

  [[ -r "${file}" ]] || return 1
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%$'\r'}"
    [[ "${line}" == *=* ]] || continue
    name="${line%%=*}"
    name="${name//[[:space:]]/}"
    [[ "${name}" == "${key}" ]] || continue
    value="${line#*=}"
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    if [[ "${value}" == \"*\" || "${value}" == \'*\' ]]; then
      value="${value:1:${#value}-2}"
    fi
    printf '%s\n' "${value}"
    return 0
  done < "${file}"

  return 1
}

# The URL clients should use for Ollama on this machine.
_ollama_endpoint() {
  if [[ "$(_nikos_var nikos_ollama_mode local)" == "remote" ]]; then
    _nikos_var nikos_ollama_remote_url ""
  else
    printf 'http://%s\n' "$(_nikos_var nikos_ollama_host 127.0.0.1:11434)"
  fi
}

# Prints the model names an endpoint reports. Fails when it does not answer.
_ollama_endpoint_models() {
  local endpoint="$1" body
  [[ -n "${endpoint}" ]] || return 1
  curl -fsS --max-time 5 "${endpoint%/}/api/version" >/dev/null 2>&1 || return 1
  body="$(curl -fsS --max-time 5 "${endpoint%/}/api/tags" 2>/dev/null)" || return 1
  printf '%s' "${body}" | grep -oE '"name":"[^"]+"' | sed 's/^"name":"//; s/"$//'
  return 0
}

# ── Ollama models: this machine's column of the approved set ──────────────────
# ai-models.env is the fleet's approved set, one model per role and class of
# machine. script-helpers picks this machine's model per role (ollama_models.sh).
# Updates keep a machine on that set: they offer to remove what is outside it,
# then pull what is missing. Models named with `nikos add model` are kept.

NIKOS_MODELS_EXTRA_FILE="${XDG_STATE_HOME:-${HOME}/.local/state}/nikos/models-extra"

_models_tool() {
  AI_MODEL_TIER="$(_nikos_var nikos_ai_model_tier "")" \
    "${NIKOS_HOME}/scripts/script-helpers/scripts/ollama_models.sh" "$@"
}

# One spelling per model: lower case, and :latest when no tag is given.
_model_norm() {
  local m="${1,,}"
  # The tag is built from two parts so tests/test_pinned_sources.py, which reads
  # ":latest" as an unpinned container image, does not flag a model name.
  [[ "${m##*/}" == *:* ]] || m="${m}:""latest"
  printf '%s\n' "${m}"
}

# This machine's tier pick for every type of work in the tiers file, and the
# picks of every lower tier: ollama_models.sh select falls back to a lower
# tier's model when the host is under a model's size floor. An unknown tier
# keeps every column: keeping too much is safe, removing a pick is not.
_models_tier_picks() {
  local tiers="${OLLAMA_MODEL_TIERS_FILE:-${NIKOS_HOME}/scripts/script-helpers/config/ollama_model_tiers.txt}"
  local tier col=0
  [[ -r "${tiers}" ]] || return 0
  tier="$(_models_tool class 2>/dev/null | sed -n 's/^tier=//p' | head -n 1)"
  case "${tier}" in
    small) col=3 ;;
    standard | medium) col=4 ;;
    large) col=5 ;;
    xlarge) col=6 ;;
  esac
  awk -v c="${col}" '$1 == "type" {
    last = (c > 0 && c < NF) ? c : NF
    for (i = 3; i <= last; i++) print $i
  }' "${tiers}"
}

# Models a local repository remembers in its .env: every variable whose name
# ends in MODEL (OLLAMA_MODEL, EMBED_MODEL) or in _CHOICE, the answer
# ollama_models.sh select stores (AI_MODEL_CODE_CHOICE by default), in either
# case. Searched one level under each directory in NIKOS_PROJECTS_DIRS
# (colon-separated, default ~/Projects).
_models_repo_choices() {
  local dir env_file
  local IFS=:
  for dir in ${NIKOS_PROJECTS_DIRS:-${HOME}/Projects}; do
    [[ -d "${dir}" ]] || continue
    for env_file in "${dir}"/.env "${dir}"/*/.env; do
      [[ -f "${env_file}" && -r "${env_file}" ]] || continue
      LC_ALL=C sed -n -E -e '1s/^\xEF\xBB\xBF//' \
        -e 's/^[[:space:]]*(export[[:space:]]+)?[A-Za-z0-9_]*([Mm][Oo][Dd][Ee][Ll]|_[Cc][Hh][Oo][Ii][Cc][Ee])[[:space:]]*=[[:space:]]*["'"'"']?([A-Za-z0-9._:/-]+)["'"'"']?[[:space:]]*(#.*)?$/\3/p' \
        -- "${env_file}"
    done
  done
}

# Models to keep: this machine's pick for every role, its tier pick for every
# type, every model a local repository's .env remembers, and the explicit extras.
_models_keep() {
  _models_tool pick "${NIKOS_HOME}/ai-models.env" || return 1
  _models_tier_picks
  _models_repo_choices
  [[ -r "${NIKOS_MODELS_EXTRA_FILE}" ]] && grep -v '^[[:space:]]*$' "${NIKOS_MODELS_EXTRA_FILE}"
  return 0
}

# Installed models outside the set to keep, one per line.
_models_outside() {
  local endpoint="$1" keep installed m
  keep="$(_models_keep)" || { print_error "Could not pick this machine's models from ai-models.env (see above)." >&2; return 1; }
  installed="$(_ollama_endpoint_models "${endpoint}")" || { print_info "Ollama is not answering at ${endpoint}." >&2; return 1; }
  keep="$(while IFS= read -r m; do [[ -n "${m}" ]] && _model_norm "${m}"; done <<<"${keep}")"
  while IFS= read -r m; do
    [[ -n "${m}" ]] || continue
    grep -qxF -- "$(_model_norm "${m}")" <<<"${keep}" || printf '%s\n' "${m}"
  done <<<"${installed}"
}

# Asks the Ollama at $1 to delete model $2.
_models_remove_one() {
  curl -fsS --max-time 60 -X DELETE "${1%/}/api/delete" \
    -H 'Content-Type: application/json' -d "{\"model\":\"$2\",\"name\":\"$2\"}" >/dev/null
}

# Offers each installed model outside the set for removal on a terminal: one
# checklist when dialog can draw, otherwise one question per model. Without a
# terminal it only lists them: nothing is removed without a yes.
_models_offer_removal() {
  local endpoint outside m answer removed=0
  [[ "$(_nikos_var nikos_ollama_mode local)" == "local" ]] || return 0
  [[ -f "${NIKOS_HOME}/ai-models.env" ]] || return 0
  endpoint="$(_ollama_endpoint)"
  if ! outside="$(_models_outside "${endpoint}")"; then
    print_info "No models offered for removal."
    return 0
  fi
  [[ -n "${outside}" ]] || return 0
  if [[ ! -t 0 || ! -t 1 ]]; then
    print_info "Installed models outside this machine's approved set (not removed, no terminal to ask):"
    awk '{ print "  " $0 }' <<<"${outside}"
    echo "  Run 'nikos models prune' on a terminal to choose, or 'nikos add model <name>' to keep one."
    return 0
  fi
  if _can_use_gauge; then
    # One checklist, nothing checked: OK with no mark, Cancel and Esc keep
    # every model.
    local -a items=()
    local picked="" list_rc=0
    while IFS= read -r m; do
      [[ -z "${m}" ]] || items+=("${m}" "" off)
    done <<<"${outside}"
    picked="$(DIALOG_ERROR=4 dialog --keep-tite --stdout --separate-output --title "NikOS: models outside the approved set" \
      --checklist "Check the models to remove. A project that still names one pulls it again when it starts. 'nikos add model <name>' keeps one for good." \
      20 76 10 "${items[@]}" </dev/tty 2>/dev/tty)" || list_rc=$?
    _leave_box
    # 4: dialog could not draw, so the text questions below ask instead.
    if (( list_rc != 4 )); then
      (( list_rc == 0 )) || picked=""
      while IFS= read -r m; do
        [[ -n "${m}" ]] || continue
        if _models_remove_one "${endpoint}" "${m}"; then
          echo "  removed ${m}"; removed=$((removed + 1))
        else
          print_error "  could not remove ${m}"
        fi
      done <<<"${picked}"
      [[ "${removed}" -eq 0 ]] || print_info "Removed ${removed} model(s)."
      return 0
    fi
  fi
  print_info "Installed models outside this machine's approved set. A project that still"
  echo "  names one pulls it again when it starts."
  while IFS= read -r m; do
    [[ -n "${m}" ]] || continue
    read -r -p "  Remove ${m}? [y/N] " answer </dev/tty || answer=""
    case "${answer,,}" in
      y | yes)
        if _models_remove_one "${endpoint}" "${m}"; then
          echo "    removed"; removed=$((removed + 1))
        else
          print_error "    could not remove ${m}"
        fi
        ;;
      *) echo "    kept (this question comes back on the next update; 'nikos add model ${m}' keeps it for good)" ;;
    esac
  done <<<"${outside}"
  [[ "${removed}" -eq 0 ]] || print_info "Removed ${removed} model(s)."
}

_models_show() {
  local endpoint outside
  endpoint="$(_ollama_endpoint)"
  echo "Approved models for this machine, one per role (ai-models.env):"
  _models_tool class "${NIKOS_HOME}/ai-models.env" | sed 's/^/  /'
  [[ -n "$(_nikos_var nikos_ai_model_tier "")" ]] && echo "  class set by nikos_ai_model_tier: $(_nikos_var nikos_ai_model_tier "")"
  echo "Modules pulled (default, plus nikos add ollama-<module>): default $(_get_saved_optional_tags | tr ',' '\n' | grep '^ollama-' | tr '\n' ' ')"
  if [[ -s "${NIKOS_MODELS_EXTRA_FILE}" ]]; then
    echo "Kept on purpose (nikos add model):"
    sed 's/^/  /' "${NIKOS_MODELS_EXTRA_FILE}"
  fi
  if outside="$(_models_outside "${endpoint}" 2>/dev/null)"; then
    if [[ -n "${outside}" ]]; then
      echo "Installed, outside the set (nikos models prune):"
      awk '{ print "  " $0 }' <<<"${outside}"
    fi
  fi
}

cmd_models() {
  case "${1:-}" in
    "" | show) _models_show ;;
    prune) _models_offer_removal ;;
    *) print_error "Unknown: nikos models ${1} (show, prune)"; exit 2 ;;
  esac
}

# nikos add model <name>: install a model outside the set on purpose, and keep it.
_add_model() {
  local m="${1:-}"
  [[ "${m}" =~ ^[A-Za-z0-9._/:-]+$ ]] || { print_error "nikos add model needs a model name, such as qwen3:14b."; exit 2; }
  [[ "$(_nikos_var nikos_ollama_mode local)" == "local" ]] || { print_error "Ollama is remote here; pull it on that machine."; exit 1; }
  OLLAMA_HOST="$(_nikos_var nikos_ollama_host 127.0.0.1:11434)" ollama pull "${m}" || exit 1
  mkdir -p "$(dirname "${NIKOS_MODELS_EXTRA_FILE}")"
  grep -qxF -- "${m}" "${NIKOS_MODELS_EXTRA_FILE}" 2>/dev/null || printf '%s\n' "${m}" >> "${NIKOS_MODELS_EXTRA_FILE}"
  print_info "${m} installed; updates keep it (listed in ${NIKOS_MODELS_EXTRA_FILE})."
}

cmd_status() {
  local endpoint
  endpoint="$(_ollama_endpoint)"
  print_info "NikOS ${NIKOS_VERSION} — Neural Innovation for Knowledge OS"
  echo ""
  echo "Profile:     $(_nikos_var nikos_profile desktop)"
  echo ""
  echo "Inference:"
  echo "  mode:      $(_nikos_var nikos_ollama_mode local)"
  echo "  endpoint:  ${endpoint:-unset}"
  echo "  node role: $(_nikos_var nikos_node_role workstation)"
  echo ""
  echo "Ollama models:"
  _ollama_endpoint_models "${endpoint}" | sed 's/^/  /' || echo "  endpoint not answering"
  echo ""
  [[ -f "${NIKOS_HOME}/ai-models.env" ]] && { _models_show; echo ""; }
  echo "distrodeck:"
  distrodeck --version 2>/dev/null || echo "  distrodeck not found"
  echo ""
  echo "conda environments:"
  "${HOME}/miniforge3/bin/conda" env list 2>/dev/null || echo "  conda not found"
  echo ""
  if [[ -d "${NIKOS_HOME}/.git" ]]; then
    echo "Repo: ${NIKOS_HOME} ($(git -C "${NIKOS_HOME}" rev-parse --short HEAD 2>/dev/null || echo 'unknown'))"
  fi
}

cmd_doctor() {
  local issues=0
  # Ubuntu 24.04 socket-activates sshd, so ssh.service is inactive until the
  # first connection; either unit being active means a login will be accepted.
  ssh_listening() {
    systemctl is-active --quiet ssh.socket || systemctl is-active --quiet ssh
  }
  conda_env_exists() {
    local conda_bin="$1"
    test -f "${conda_bin}" && "${conda_bin}" env list | grep -q nikos-ai
  }
  check() {
    local label="$1"
    shift
    if "$@" &>/dev/null; then
      print_success "${label}"
    else
      print_error "${label}"
      issues=$((issues + 1))
    fi
  }
  optional_check() {
    local label="$1"
    shift
    if "$@" &>/dev/null; then
      print_success "${label}"
    else
      print_warn "${label} (optional or pending first login)"
    fi
  }
  # A binary on PATH says nothing about whether anything answers. Issue a
  # request and read the reply, in every mode: a remote node can be off or
  # moved, and only a request finds that out.
  _doctor_inference() {
    local mode endpoint models
    mode="$(_nikos_var nikos_ollama_mode local)"
    endpoint="$(_ollama_endpoint)"
    print_info "Inference: mode=${mode} endpoint=${endpoint:-unset} node role=$(_nikos_var nikos_node_role workstation)"
    if [[ "${mode}" == "local" ]]; then
      check "Ollama installed" command -v ollama
      check "Ollama service active" systemctl is-active --quiet ollama
    fi
    if models="$(_ollama_endpoint_models "${endpoint}")"; then
      print_success "Ollama endpoint answers at ${endpoint}"
      if [[ -n "${models}" ]]; then
        printf '  models: %s\n' "$(printf '%s' "${models}" | paste -sd ' ' -)"
      else
        printf '  models: none pulled yet\n'
      fi
    else
      print_error "Ollama endpoint does not answer at ${endpoint:-unset}"
      issues=$((issues + 1))
    fi
    [[ "${mode}" == "local" ]] && _doctor_ollama_bridge
  }
  # Containers reach the local Ollama through the forwarder on the Docker
  # bridge. A listed socket is not proof (FreeBind binds an address that does
  # not exist yet), so ask it for /api/version.
  _doctor_ollama_bridge() {
    local unit="${NIKOS_SYSTEMD_DIR:-/etc/systemd/system}/nikos-ollama-bridge.socket" listen
    if [[ -f "${unit}" ]]; then
      listen="$(sed -n 's/^ListenStream=//p' "${unit}" | head -1)"
      # From loopback: a host request to its own bridge address goes out with
      # that address as source, and was seen dropped while containers got answers.
      check "Ollama forwarder answers on the Docker bridge (${listen})" \
        curl -fsS --max-time 5 --interface 127.0.0.1 -o /dev/null "http://${listen}/api/version"
      # A LAN or VPN in 172.16.0.0/12 is dropped by the interface filter (a
      # warning); an interface that is not Docker's but passes the filter is
      # refused. Docker names its own bridges; every other counts.
      # Refused starts (a shared range, an unreadable check) count against the
      # socket's trigger limit, and a socket that hit it stays failed after the
      # cause is gone.
      if systemctl is-failed --quiet nikos-ollama-bridge.socket 2>/dev/null; then
        print_error "Ollama forwarder socket has failed (refused starts hit its limit). After fixing the cause: sudo systemctl reset-failed nikos-ollama-bridge.socket && sudo systemctl start nikos-ollama-bridge.socket"
        issues=$((issues + 1))
      fi
      check "Ollama forwarder's interface filter loaded" systemctl is-active --quiet nikos-ollama-bridge-filter.service
      # ufw's default deny drops a container's packets to the host before the
      # forwarder sees them; a request from the host itself still passes.
      # ufw.service is a oneshot that stays "active" with the firewall off;
      # ENABLED= in ufw.conf is what says whether it filters.
      if grep -Eqs '^ENABLED=yes' "${NIKOS_UFW_CONF:-/etc/ufw/ufw.conf}"; then
        print_warn "ufw is active: containers reach the forwarder only if it allows them, e.g. sudo ufw allow in on docker0 to any port ${listen##*:} proto tcp (and each Docker br-* network)"
      fi
      # The same check the forwarder runs before every start (roles/ai-stack).
      local guard="${NIKOS_HOME}/roles/ai-stack/files/nikos-ollama-bridge-check" shared rc=0
      if command -v docker >/dev/null 2>&1 && ! docker info >/dev/null 2>&1; then
        # As a user without access to Docker the check cannot read Docker's
        # networks; the forwarder itself runs it as root.
        print_warn "Ollama forwarder: networks not checked here (no access to Docker as $(id -un)); the forwarder checks them as root before every start"
      elif [[ ! -x "${guard}" ]]; then
        print_warn "Ollama forwarder: ${guard} is missing; the networks were not checked"
      else
        local errf warns
        errf="$(mktemp)"
        # nft needs root; the filter unit being active is the proof here.
        local vouch=""
        systemctl is-active --quiet nikos-ollama-bridge-filter.service 2>/dev/null && vouch=1
        shared="$(NIKOS_BRIDGE_CHECK_IGNORE_LOADED="${vouch}" "${guard}" 2>"${errf}")" || rc=$?
        warns="$(grep '^warning: ' "${errf}" || true)"
        shared="${shared:-$(grep -v '^warning: ' "${errf}" || true)}"
        rm -f "${errf}"
        # Another network in the range is dropped by the interface filter: a warning.
        while IFS= read -r w; do [[ -n "${w}" ]] && print_warn "Ollama forwarder: ${w#warning: }"; done <<<"${warns}"
        case "${rc}" in
          0) print_success "Ollama forwarder: only Docker's bridges pass its interface filter" ;;
          1) print_error "Ollama forwarder: ${shared//$'\n'/, } would pass its interface filter. It refuses to start while that holds; nikos update removes it, or set nikos_ollama_bridge to off"
             issues=$((issues + 1)) ;;
          *) print_error "Ollama forwarder: the networks could not be checked (${shared}); it refuses to start"
             issues=$((issues + 1)) ;;
        esac
      fi
    elif command -v docker >/dev/null 2>&1 && [[ "$(_nikos_var nikos_ollama_bridge auto)" != "off" ]]; then
      print_warn "No Ollama forwarder on the Docker bridge: containers cannot reach the local Ollama. Run: nikos update"
    fi
  }
  # The release, before anything else: every later line is read against it.
  # Outside the supported list the result is a warning, not a failure: doctor
  # reports what is there, and `nikos update` cannot change the release.
  _doctor_os() {
    local os_id version_id pretty codename
    os_id="$(_os_release_value ID || true)"
    version_id="$(_os_release_value VERSION_ID || true)"
    pretty="$(_os_release_value PRETTY_NAME || true)"
    codename="$(_os_release_value VERSION_CODENAME || _os_release_value UBUNTU_CODENAME || true)"
    if [[ -z "${os_id}" && -z "${version_id}" ]]; then
      print_warn "OS: ${NIKOS_OS_RELEASE_FILE:-/etc/os-release} is unreadable or names no ID and VERSION_ID; the release could not be checked"
      return 0
    fi
    print_info "OS: ${pretty:-${os_id} ${version_id}} (ID=${os_id:-?} VERSION_ID=${version_id:-?} codename=${codename:-?})"
    # Keep in step with install.sh and nikos_ubuntu_releases in vars/main.yml.
    local supported=no
    if [[ "${os_id}" == "ubuntu" ]]; then
      case "${version_id}" in
        22.04|24.04|26.04) supported=yes ;;
      esac
    fi
    if [[ "${supported}" == "yes" ]]; then
      print_success "Ubuntu ${version_id} is a supported release"
    else
      print_warn "${os_id:-?} ${version_id:-?} is not a supported release (Ubuntu or Xubuntu 22.04, 24.04 or 26.04 LTS); the checks below may not apply"
    fi
  }
  local profile
  profile="$(_nikos_var nikos_profile desktop)"
  print_info "NikOS Doctor — checking system health (profile: ${profile})..."
  _doctor_os
  check "ansible installed" command -v ansible-playbook
  check "dialog installed" command -v dialog
  check "gh CLI installed" command -v gh
  check "tmux installed" command -v tmux
  _doctor_inference
  check "distrodeck installed" command -v distrodeck
  optional_check "llama.cpp installed" command -v llama-server
  optional_check "shell-gpt installed" command -v sgpt
  optional_check "glances installed" command -v glances
  optional_check "mkcert installed" command -v mkcert
  optional_check "conda installed" test -f "${HOME}/miniforge3/bin/conda"
  optional_check "nikos-ai env exists" conda_env_exists "${HOME}/miniforge3/bin/conda"
  optional_check "Claude Code installed" command -v claude
  optional_check "Gemini CLI installed" command -v gemini
  # The desktop checks are hard failures on a desktop install and are not run
  # at all on a server one, where their absence is the correct result.
  if [[ "${profile}" == "desktop" ]]; then
    check "VS Code installed" command -v code
    check "Nordic GTK theme" test -d /usr/share/themes/Nordic
    check "Papirus icons" test -d /usr/share/icons/Papirus-Dark
    # Opt-in (nikos add antigravity), so a warning, not a failure.
    optional_check "Antigravity IDE installed (nikos add antigravity)" \
      test -x "/snap/bin/$(_nikos_var nikos_antigravity_ide_command antigravity-ide-snap.antigravity-ide)"
  else
    print_info "Skipping desktop checks (VS Code, Nordic, Papirus) for profile ${profile}"
  fi
  check "SSH server installed" test -x /usr/sbin/sshd
  check "SSH accepting connections" ssh_listening
  # The base role turns NTP on where systemd has a time sync unit to drive.
  # CanNTP=no is a warning, since `nikos update` cannot change it. So is NTP
  # off in a container running systemd: a daemon package can give CanNTP=yes
  # there, but ConditionVirtualization keeps its unit stopped.
  ntp_property() { timedatectl show --property="$1" --value 2>/dev/null; }
  time_daemon_packages() {
    dpkg-query -W -f='${Package} ${Status}\t${Provides}\n' 2>/dev/null |
      awk -F'\t' '$1 ~ / installed$/ && $2 ~ /(^|[ ,])time-daemon($|[ ,(])/ {
        sub(/ .*/, "", $1); names = names (names == "" ? "" : ", ") $1
      } END { if (names != "") print names }'
  }
  if [[ "$(ntp_property CanNTP)" != "yes" ]]; then
    local ntp_daemons
    ntp_daemons="$(time_daemon_packages || true)"
    print_warn "systemd has no NTP unit to drive${ntp_daemons:+; installed time daemon: ${ntp_daemons}} (NTP off)"
  elif [[ "$(ntp_property NTP)" != "yes" ]] && systemd-detect-virt --container --quiet; then
    print_warn "NTP off: a container running systemd does not start the time sync unit"
  else
    check "NTP time sync enabled" test "$(ntp_property NTP)" = yes
  fi
  optional_check "Git setup done or skipped (nikos-git-setup)" test -f "${HOME}/.config/nikos/github-configured"
  check "NikOS repo present" test -d "${NIKOS_HOME}/.git"
  check "script-helpers present" test -f "${HELPERS}"
  # Hooks (nikos hooks): optional, since owners are set by hand once per machine.
  optional_check "git-lantern has 'hooks'" lantern hooks --help
  optional_check "agentvault installed" command -v agentvault
  optional_check "gitleaks installed" command -v gitleaks
  optional_check "foxguard installed" command -v foxguard
  optional_check "script-helpers.owners set (nikos hooks)" git config --global --get script-helpers.owners
  echo ""
  if [[ ${issues} -eq 0 ]]; then
    print_success "All checks passed."
  else
    print_error "${issues} issue(s) found. Run 'nikos update' to attempt repair."
    return 1
  fi
}

cmd_log() {
  local arg="${1:-50}"
  if [[ "${arg}" == "list" ]]; then
    if [[ ! -d "${NIKOS_LOG_DIR}" ]]; then
      print_info "No logs yet. Run 'nikos setup' or 'nikos update' first."
      return 0
    fi
    print_info "Available logs in ${NIKOS_LOG_DIR}:"
    find "${NIKOS_LOG_DIR}" -maxdepth 1 -name '*.log' ! -name '*latest*' \
      -printf '%T@ %p\n' 2>/dev/null \
      | sort -rn | awk '{print "  " $2}' \
      || echo "  (none)"
    return 0
  fi

  if ! [[ "${arg}" =~ ^[0-9]+$ ]]; then
    print_error "'nikos log' expects a number or 'list', got: ${arg}"
    print_info "Usage: nikos log [N]        # show last N lines (default 50)"
    print_info "       nikos log list       # list all log files"
    return 1
  fi

  local latest="${NIKOS_LOG_DIR}/playbook-latest.log"
  if [[ ! -f "${latest}" ]]; then
    # Fall back to install log if no playbook log exists yet
    latest="${NIKOS_LOG_DIR}/install-latest.log"
  fi
  if [[ ! -f "${latest}" ]]; then
    print_info "No log found. Run 'nikos setup' first."
    return 0
  fi

  print_info "Last ${arg} lines of $(readlink -f "${latest}"):"
  echo "----------------------------------------"
  tail -n "${arg}" "${latest}"
  echo "----------------------------------------"
}

_print_logo

if [[ $# -eq 0 ]]; then
  # Bare `nikos`: the menu on a terminal; usage, exit 0, everywhere else
  # (piped stdin, no terminal, NIKOS_USE_DIALOG=0, no dialog).
  if _menu_available; then cmd_menu; else usage; fi
  exit 0
fi

case "${1}" in
  setup)  cmd_setup ;;
  update)
    case "${2:-}" in
      "") cmd_update ;;
      --ref)
        [[ -n "${3:-}" ]] || { print_error "nikos update --ref needs a branch or tag."; exit 2; }
        cmd_update "$3"
        ;;
      --ref=*) cmd_update "${2#--ref=}" ;;
      *) print_error "Unknown option for nikos update: ${2}"; exit 2 ;;
    esac
    ;;
  add)    cmd_add "${2:-}" "${3:-}" ;;
  models) cmd_models "${2:-}" ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  clean)  shift; exec bash "${NIKOS_HOME}/scripts/clean-caches.sh" "$@" ;;
  hooks)  shift; exec bash "${NIKOS_HOME}/scripts/nikos-hooks.sh" "$@" ;;
  log)    cmd_log "${2:-50}" ;;
  help | --help | -h) usage ;;
  *)
    print_error "Unknown command: ${1}"
    usage
    exit 1
    ;;
esac
