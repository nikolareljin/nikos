# NikOS boot splash.
#
# Plymouth runs before any icon theme, font config or toolkit exists, so every
# element here is a pre-rendered PNG copied into this directory by the theming
# role. They are generated from the NikOS artwork by
# scripts/render-plymouth-assets.py.
#
# Layout, top to bottom, centred on the primary display:
#
#     logo-mono.png        the mark and wordmark
#     spinner-NNNN.png     the "N" with a highlight running along it
#     progress-meter.png   boot or fsck progress, drawn only when known
#     passw-dialog.png     password entry, drawn only when prompted
#
# The password path matters on an encrypted disk: without it the boot sits on
# the logo with no visible prompt while it waits for a passphrase.

Window.SetBackgroundTopColor(0.05, 0.05, 0.08);
Window.SetBackgroundBottomColor(0.02, 0.02, 0.05);

screen_x = Window.GetX();
screen_y = Window.GetY();
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# ── Images ───────────────────────────────────────────────────────────────────

logo_image = Image("logo-mono.png");
progress_meter_image = Image("progress-meter.png");
progress_fade_image = Image("progress-fade.png");
fsck_meter_image = Image("fsck-meter.png");
fsck_fade_image = Image("fsck-fade.png");
passw_dialog_image = Image("passw-dialog.png");
bullet_image = Image("bullet.png");

SPINNER_FRAMES = 36;
# One highlight pass takes SPINNER_FRAMES * SPINNER_HOLD refreshes. Plymouth
# refreshes 50 times a second, so 2 gives a pass of about 1.4 seconds.
SPINNER_HOLD = 2;

# Initialised explicitly, as the message ring below is. Plymouth's engine does
# auto-vivify: script_evaluate_hash() replaces a non-hash with a fresh hash
# before indexing it, so a bare declaration would work. An empty set literal
# says what the variable is for without relying on that.
spinner_images = [];

for (i = 0; i < SPINNER_FRAMES; i++) {
    # Frame files are one-based and zero-padded to four digits.
    n = i + 1;
    if (n < 10) {
        name = "spinner-000" + n + ".png";
    } else {
        name = "spinner-00" + n + ".png";
    }
    spinner_images[i] = Image(name);
}

# ── Logo ─────────────────────────────────────────────────────────────────────

# Hold the mark to at most 30% of the screen width, so it stays a splash rather
# than filling a small panel or getting lost on a large one.
logo_width = logo_image.GetWidth();
logo_height = logo_image.GetHeight();
max_logo_width = Math.Int(screen_width * 0.30);
if (logo_width > max_logo_width) {
    scale = max_logo_width / logo_width;
} else {
    scale = 1.0;
}
logo_image = logo_image.Scale(Math.Int(logo_width * scale), Math.Int(logo_height * scale));
logo_width = logo_image.GetWidth();
logo_height = logo_image.GetHeight();

logo_sprite = Sprite(logo_image);
logo_x = screen_x + Math.Int((screen_width - logo_width) / 2);
logo_y = screen_y + Math.Int((screen_height - logo_height) / 2) - 40;
logo_sprite.SetPosition(logo_x, logo_y, 10);
logo_sprite.SetOpacity(1.0);

# Everything below the logo hangs off its lower edge.
below_logo_y = logo_y + logo_height;

# ── Spinner ──────────────────────────────────────────────────────────────────

spinner_sprite = Sprite(spinner_images[0]);
spinner_sprite.SetPosition(
    screen_x + Math.Int((screen_width - spinner_images[0].GetWidth()) / 2),
    below_logo_y + 30,
    10);
spinner_sprite.SetOpacity(1.0);

spinner_index = 0;
spinner_tick = 0;

# ── Progress ─────────────────────────────────────────────────────────────────

progress_x = screen_x + Math.Int((screen_width - progress_meter_image.GetWidth()) / 2);
# Clears the spinner, which is 96px tall and starts 30px below the logo.
progress_y = below_logo_y + 150;

progress_meter_sprite = Sprite(progress_meter_image);
progress_meter_sprite.SetPosition(progress_x, progress_y, 10);
progress_meter_sprite.SetOpacity(0);

progress_fade_sprite = Sprite(progress_fade_image.Scale(1, progress_fade_image.GetHeight()));
progress_fade_sprite.SetPosition(progress_x, progress_y, 11);
progress_fade_sprite.SetOpacity(0);

fsck_x = screen_x + Math.Int((screen_width - fsck_meter_image.GetWidth()) / 2);

fsck_meter_sprite = Sprite(fsck_meter_image);
fsck_meter_sprite.SetPosition(fsck_x, progress_y, 10);
fsck_meter_sprite.SetOpacity(0);

fsck_fade_sprite = Sprite(fsck_fade_image.Scale(1, fsck_fade_image.GetHeight()));
fsck_fade_sprite.SetPosition(fsck_x, progress_y, 11);
fsck_fade_sprite.SetOpacity(0);

fsck_running = 0;

# Per-device check progress, keyed by device name, with the names kept in a
# parallel list because the script language cannot enumerate hash keys. The
# percentage shown is the mean over every device seen so far, so a run over
# several disks advances smoothly instead of jumping per device.
fsck_percent = [];
fsck_seen = [];
fsck_names = [];
fsck_device_count = 0;

# ── Password prompt ──────────────────────────────────────────────────────────

passw_dialog_sprite = Sprite(passw_dialog_image);
passw_dialog_sprite.SetPosition(
    screen_x + Math.Int((screen_width - passw_dialog_image.GetWidth()) / 2),
    below_logo_y + 70,
    10);
passw_dialog_sprite.SetOpacity(0);

passw_label_sprite = Sprite();
passw_label_sprite.SetOpacity(0);

bullets_array = [];
bullets_count = 0;

MAX_BULLETS = 14;

# Upper bound on characters scanned in a status record or number.
MAX_FIELD_SCAN = 256;

# ── Messages ─────────────────────────────────────────────────────────────────

MESSAGE_SLOTS = 5;

# A ring: message_head is the slot the next message goes into, and the most
# recent MESSAGE_SLOTS messages are read back from it in reverse. Nothing is
# copied between slots when a message arrives.
message_ring = [];
message_head = 0;
message_shown = 0;

# ── Helpers ──────────────────────────────────────────────────────────────────

# Plymouth exposes String.Length natively, so there is no hand-rolled length
# counter here; these helpers cover what it does not provide.

fun digit_value(character) {
    if (character == "0") return 0;
    if (character == "1") return 1;
    if (character == "2") return 2;
    if (character == "3") return 3;
    if (character == "4") return 4;
    if (character == "5") return 5;
    if (character == "6") return 6;
    if (character == "7") return 7;
    if (character == "8") return 8;
    if (character == "9") return 9;
    return -1;
}

# Leading integer of a string, or -1 when it does not start with a digit.
# Accumulates as it goes, so it is not bounded to any particular range.
fun int_prefix(text) {
    value = 0;
    digits = 0;
    for (i = 0; i < MAX_FIELD_SCAN; i++) {
        digit = digit_value(String(text).CharAt(i));
        if (digit < 0) break;
        value = (value * 10) + digit;
        digits++;
    }
    if (digits == 0) return -1;
    return value;
}

# One colon-separated field of a status record, "" when the record has no such
# field. Reading fields on demand avoids splitting the whole record into an
# array that the callers then have to agree on the shape of.
fun status_field(record, wanted) {
    field = "";
    index = 0;
    for (i = 0; i < MAX_FIELD_SCAN; i++) {
        character = String(record).CharAt(i);
        if (character == "") break;
        if (character == ":") {
            index++;
            if (index > wanted) break;
        } else {
            if (index == wanted) field += character;
        }
    }
    return field;
}

fun set_progress(meter_sprite, fade_sprite, fade_image, meter_image, fraction) {
    if (fraction < 0) {
        fraction = 0;
    }
    if (fraction > 1) {
        fraction = 1;
    }
    width = Math.Int(meter_image.GetWidth() * fraction);
    if (width < 1) {
        width = 1;
    }
    meter_sprite.SetOpacity(1);
    fade_sprite.SetOpacity(1);
    fade_sprite.SetImage(fade_image.Scale(width, fade_image.GetHeight()));
}

# ── Refresh ──────────────────────────────────────────────────────────────────

fun refresh_callback() {
    # The prompt owns the screen while it is up: a spinner next to a password
    # field reads as the machine still working rather than waiting on input.
    if (passw_dialog_sprite.GetOpacity() == 1) {
        spinner_sprite.SetOpacity(0);
        return;
    }

    spinner_sprite.SetOpacity(1);

    spinner_tick++;
    if (spinner_tick >= SPINNER_HOLD) {
        spinner_tick = 0;
        spinner_index++;
        if (spinner_index >= SPINNER_FRAMES) {
            spinner_index = 0;
        }
        spinner_sprite.SetImage(spinner_images[spinner_index]);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

# ── Boot progress ────────────────────────────────────────────────────────────

fun boot_progress_callback(duration, progress) {
    # fsck owns the bar while it runs, so it is not overwritten here.
    if (fsck_running == 1) {
        return;
    }
    set_progress(progress_meter_sprite, progress_fade_sprite,
                 progress_fade_image, progress_meter_image, progress);
}

Plymouth.SetBootProgressFunction(boot_progress_callback);

# ── Password prompt ──────────────────────────────────────────────────────────

fun display_password_callback(prompt, bullets) {
    passw_dialog_sprite.SetOpacity(1);
    passw_label_sprite.SetOpacity(1);

    prompt_image = Image.Text(prompt, 0.85, 0.87, 0.91);
    passw_label_sprite.SetImage(prompt_image);
    passw_label_sprite.SetPosition(
        screen_x + Math.Int((screen_width - prompt_image.GetWidth()) / 2),
        below_logo_y + 40,
        10);

    for (i = 0; i < bullets_count; i++) {
        bullets_array[i] = NULL;
    }
    bullets_count = 0;

    shown = bullets;
    if (shown > MAX_BULLETS) {
        shown = MAX_BULLETS;
    }

    # Centre the row of bullets inside the dialog rather than left-aligning it,
    # so a short passphrase does not sit against the left edge. The row ends at
    # the right edge of the last bullet, so it spans the gaps between bullets
    # plus one bullet width; counting a gap after the last one would push every
    # row off centre by half a gap.
    spacing = 18;
    row_width = ((shown - 1) * spacing) + bullet_image.GetWidth();
    row_x = screen_x + Math.Int((screen_width - row_width) / 2);

    for (i = 0; i < shown; i++) {
        bullets_array[i] = Sprite(bullet_image);
        bullets_array[i].SetPosition(
            row_x + (i * spacing),
            below_logo_y + 81,
            11);
        bullets_count++;
    }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    passw_dialog_sprite.SetOpacity(0);
    passw_label_sprite.SetOpacity(0);
    for (i = 0; i < bullets_count; i++) {
        bullets_array[i] = NULL;
    }
    bullets_count = 0;
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ── Messages ─────────────────────────────────────────────────────────────────

fun message_callback(text) {
    if ((text == "") || !text) {
        return 0;
    }

    # Plymouth prefixes some messages for consumers that localise them. NikOS
    # shows them verbatim, so the prefixes come off.
    if (text.SubString(0, 5) == "keys:") {
        text = text.SubString(5, String(text).Length());
    }
    # systemd-fsckd sends this while checks are running, not when they end: it
    # carries "Press Ctrl+C to cancel all filesystem checks in progress", and
    # fsckd clears it afterwards. Only the prefix comes off. Touching the fsck
    # state here would hide a live meter and let boot progress draw over it.
    if (text.SubString(0, 17) == "fsckd-cancel-msg:") {
        text = text.SubString(17, String(text).Length());
    }

    message_ring[message_head] = Sprite(Image.Text(text, 0.55, 0.59, 0.65));
    message_head = (message_head + 1) % MESSAGE_SLOTS;
    if (message_shown < MESSAGE_SLOTS) message_shown++;

    # Walk back from the newest, stacking upwards from the bottom edge.
    for (row = 0; row < message_shown; row++) {
        slot = (message_head - 1 - row + (2 * MESSAGE_SLOTS)) % MESSAGE_SLOTS;
        line = message_ring[slot];
        if (line == NULL) continue;
        line.SetPosition(
            screen_x + Math.Int((screen_width - line.GetImage().GetWidth()) / 2),
            screen_y + (screen_height - line.GetImage().GetHeight()) - (20 * (row + 1)),
            10);
    }
}

Plymouth.SetMessageFunction(message_callback);

# ── Status, used for fsck progress ───────────────────────────────────────────

# Record or update one device's progress and return the mean across every
# device seen. Keyed by device name, so a repeated report for a device updates
# it in place rather than being searched for.
fun fsck_record(device, percent) {
    if (fsck_seen[device] != 1) {
        fsck_seen[device] = 1;
        fsck_names[fsck_device_count] = device;
        fsck_device_count++;
    }
    fsck_percent[device] = percent;

    total = 0;
    for (i = 0; i < fsck_device_count; i++) {
        total += fsck_percent[fsck_names[i]];
    }
    return total / fsck_device_count;
}

fun fsck_show(percent) {
    if (fsck_running == 0) {
        fsck_running = 1;
        # The two bars share a row, so the boot bar steps aside while a disk
        # check owns it. boot_progress_callback returns early while this is set.
        progress_meter_sprite.SetOpacity(0);
        progress_fade_sprite.SetOpacity(0);
        # Said once per run, not per record: fsck reports continuously.
        message_callback("Checking disks");
    }

    set_progress(fsck_meter_sprite, fsck_fade_sprite,
                 fsck_fade_image, fsck_meter_image, percent / 100);

    if (percent >= 100) {
        fsck_meter_sprite.SetOpacity(0);
        fsck_fade_sprite.SetOpacity(0);
        fsck_running = 0;
    }
}

fun status_callback(status) {
    kind = status_field(status, 0);

    # Upstart-era mountall: fsck:<device>:<percent>, one device per record, so
    # the bar shows the mean over the devices reported so far.
    if (kind == "fsck") {
        device = status_field(status, 1);
        percent = int_prefix(status_field(status, 2));
        if (device == "") return 0;
        if (percent < 0) return 0;

        fsck_show(fsck_record(device, percent));
        return 0;
    }

    # systemd-fsckd reports the whole run in one record. Its format string is
    # "fsckd:%d:%3.1f:%s", so field 2 is the percentage, carrying one fractional
    # digit whose separator follows the locale; int_prefix takes the integer.
    if (kind == "fsckd") {
        percent = int_prefix(status_field(status, 2));
        if (percent < 0) return 0;

        fsck_show(percent);
        return 0;
    }
}

Plymouth.SetUpdateStatusFunction(status_callback);

# ── Shutdown ─────────────────────────────────────────────────────────────────

fun quit_callback() {
    # display_normal_callback drops the bullets; quitting straight out of the
    # prompt has to do the same, or they stay on screen over the handover.
    for (i = 0; i < bullets_count; i++) {
        bullets_array[i] = NULL;
    }
    bullets_count = 0;

    spinner_sprite.SetOpacity(0);
    progress_meter_sprite.SetOpacity(0);
    progress_fade_sprite.SetOpacity(0);
    fsck_meter_sprite.SetOpacity(0);
    fsck_fade_sprite.SetOpacity(0);
    passw_dialog_sprite.SetOpacity(0);
    passw_label_sprite.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
