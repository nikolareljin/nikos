<?xml version="1.0" encoding="UTF-8"?>
<!--
  NikOS backdrop defaults.

  image-style 4 (Scaled) keeps the whole image on screen on any aspect ratio;
  color-style 0 with rgba1 set to #2e3440 - the flat base colour of the NikOS
  wallpapers - fills whatever the image does not cover, so the edges read as
  part of the artwork rather than as bars.

  Only monitor0 can be named here. xfdesktop creates the connector-named
  backdrops (monitorHDMI-A-0, monitorDisplayPort-2, ...) at first login and
  seeds them from these values; nikos-apply-wallpaper then fixes them up in
  the live session, and picks the portrait wallpaper for rotated monitors.
-->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="image-path" type="string" value="/usr/share/nikos/wallpaper.png"/>
        <property name="image-show" type="bool" value="true"/>
        <property name="image-style" type="int" value="4"/>
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/nikos/wallpaper.png"/>
          <property name="image-style" type="int" value="4"/>
          <property name="color-style" type="int" value="0"/>
          <property name="rgba1" type="array">
            <value type="double" value="0.180392"/>
            <value type="double" value="0.203922"/>
            <value type="double" value="0.250980"/>
            <value type="double" value="1.000000"/>
          </property>
        </property>
      </property>
    </property>
  </property>
</channel>
