export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$HOME/go/bin:$PATH"

if [ -x /usr/local/bin/nikos-welcome ]; then
  /usr/local/bin/nikos-welcome
fi

if [ -f "$HOME/miniforge3/etc/profile.d/conda.sh" ]; then
