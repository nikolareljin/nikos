#!/usr/bin/env bash
# Managed by NikOS (roles/ai-stack). Loads Docker's current bridge names into
# the forwarder filter's set (inet nikos_ollama_bridge docker_ifs), in one nft
# transaction. Run when the filter loads and on every Docker network create or
# destroy (nikos-ollama-bridge-watch.service).
set -euo pipefail
# Installed beside the check (both in /usr/local/libexec).
check="$(dirname "$0")/nikos-ollama-bridge-check"

# --watch: refresh on every Docker network create or destroy until Docker's
# event stream ends (the unit restarts it). A failed refresh is retried on the
# next event; the set keeps its last good content.
if [[ "${1:-}" == "--watch" ]]; then
  docker events --filter type=network --filter event=create --filter event=destroy --format x \
    | while read -r _; do "$0" || true; done
  exit 1
fi
names="$("${check}" --docker-ifs)"
elems=""
for n in ${names}; do elems="${elems:+${elems}, }\"${n}\""; done
{
  echo "flush set inet nikos_ollama_bridge docker_ifs"
  [[ -z "${elems}" ]] || echo "add element inet nikos_ollama_bridge docker_ifs { ${elems} }"
} | nft -f -
