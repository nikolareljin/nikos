#!/usr/bin/env bash
# Managed by NikOS (roles/ai-stack). Run by the play, by nikos-ollama-bridge.service
# before every start (ExecCondition), and by `nikos doctor`.
#
# The Ollama forwarder admits any source in 172.16.0.0/12. That is Docker's
# range only while no other network on this machine uses it: on a LAN or VPN
# in that range, a neighbour with a route to the bridge address would reach an
# Ollama that has no authentication. Docker names its own bridge interfaces;
# every other interface counts, whatever it is called.
#
# Prints each other interface in 172.16.0.0/12 as "name address".
# Exit: 0 none (the forwarder may run); 1 one or more (it must not);
#       2 the interfaces could not be read (it must not: no answer is not "none").
set -uo pipefail

addrs="$(ip -4 -o addr show 2>/dev/null)" || { echo "cannot read the network interfaces (ip -4 addr)" >&2; exit 2; }
[[ -n "${addrs}" ]] || { echo "no network interfaces listed (ip -4 addr)" >&2; exit 2; }

docker_ifs=""
if command -v docker >/dev/null 2>&1; then
  ids="$(docker network ls -q --filter driver=bridge 2>/dev/null)" || { echo "cannot list Docker's networks" >&2; exit 2; }
  for id in ${ids}; do
    # shellcheck disable=SC2016  # a docker template, not a shell expansion
    name="$(docker network inspect -f '{{index .Options "com.docker.network.bridge.name"}}' "${id}" 2>/dev/null)" \
      || { echo "cannot inspect Docker network ${id}" >&2; exit 2; }
    docker_ifs="${docker_ifs} ${name:-br-${id:0:12}}"
  done
fi

shared="$(printf '%s\n' "${addrs}" \
  | awk -v keep="lo${docker_ifs}" 'BEGIN { n = split(keep, k, " "); for (i = 1; i <= n; i++) skip[k[i]] = 1 }
                                     !($2 in skip) { print $2, $4 }' \
  | grep -E ' 172\.(1[6-9]|2[0-9]|3[01])\.')"
[[ -z "${shared}" ]] && exit 0
printf '%s\n' "${shared}"
exit 1
