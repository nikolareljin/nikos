{
  "workbench.colorTheme": "Nord",
  "workbench.colorCustomizations": {
    "tab.activeBackground": "#88C0D0",
    "tab.activeForeground": "#2E3440",
    "tab.activeBorder": "#8FBCBB",
    "tab.activeBorderTop": "#5E81AC",
    "tab.unfocusedActiveBackground": "#4C566A",
    "tab.unfocusedActiveForeground": "#ECEFF4",
    "tab.unfocusedActiveBorderTop": "#3B4252"
  },
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
